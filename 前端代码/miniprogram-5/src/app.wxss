/** app.wxss */
page {
  /* 统一高级感中式草本主题 (Premium Herb Theme) */
  --page-bg: #fbfaee;
  --page-ink: #1b1c15;
  --page-muted: #42493e;
  --page-soft: #72796e;
  --primary: #2d5a27;
  --primary-deep: #154212;
  --secondary: #50644a;
  --secondary-soft: #d0e6c6;
  --gold: #c5a059;
  --gold-soft: #f3e2b9;
  --line: #c2c9bb;
  --surface: rgba(255, 255, 255, 0.88);
  --surface-soft: #f5f4e8;
  --surface-mid: #efeee3;
  --danger: #ba1a1a;
  --danger-soft: #ffdad6;

  /* 兼容性桥接变量 (Legacy Compatibility) */
  --primary-color: var(--primary);
  --primary-strong: var(--primary-deep);
  --accent-color: var(--gold);
  --bg-color: var(--page-bg);
  --card-bg: var(--surface);
  --text-main: var(--page-ink);
  --text-sub: var(--page-muted);
  --text-light: var(--page-soft);
  --border-color: var(--line);
  --border-strong: #c8d6c8;
  --layout-gap: 20rpx;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --card-shadow: 0 12rpx 40rpx rgba(45, 90, 39, 0.08);
  --glass-blur: blur(15px);

  min-height: 100%;
  background-color: var(--page-bg);
  color: var(--page-ink);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.page-container {
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
  padding: 28rpx 24rpx 42rpx;
  display: flex;
  flex-direction: column;
}

.header {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.title {
  display: block;
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  color: var(--primary-color);
}

.desc {
  display: block;
  margin-top: 0;
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--text-sub);
}

