.list-pill {
  font-size: 22rpx;
  color: #566848;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(86, 104, 72, 0.2);
  background: #f4faef;
}

.list-index {
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background: #f4faef;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}

.list-index-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #566848;
}
