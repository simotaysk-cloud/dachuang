.terminal-picker {
  margin-top: 18rpx;
}

.terminal-preview-modal {
  max-width: 620rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.97) 0%, rgba(245, 244, 232, 0.96) 100%);
  border: 1rpx solid rgba(128, 141, 121, 0.12);
  border-radius: 30rpx;
  box-shadow: 0 24rpx 52rpx rgba(54, 66, 47, 0.18);
  text-align: center;
}

.qr-preview {
  width: 100%;
  height: 520rpx;
  margin-top: 20rpx;
  border: 1rpx solid rgba(128, 141, 121, 0.12);
  border-radius: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f7f6ee 100%);
}
