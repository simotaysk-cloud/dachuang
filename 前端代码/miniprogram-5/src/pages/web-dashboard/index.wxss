.planting-dashboard-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 72rpx;
  box-sizing: border-box;
  position: relative;
  overflow-x: hidden;
  background: var(--page-bg);
}

.page-aura {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
  filter: blur(70rpx);
  opacity: 0.8;
}

.aura-left {
  top: 80rpx;
  left: -140rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(208, 230, 198, 0.48);
}

.aura-right {
  top: 340rpx;
  right: -120rpx;
  width: 280rpx;
  height: 280rpx;
  background: rgba(243, 226, 185, 0.42);
}

.header-card,
.summary-card,
.chart-card {
  position: relative;
  z-index: 1;
}

.header-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 16rpx 38rpx rgba(27, 28, 21, 0.06);
}

.header-title,
.header-subtitle,
.summary-value,
.summary-label,
.summary-note,
.chart-title,
.chart-caption,
.bar-name,
.bar-value,
.tag-name,
.tag-value,
.empty-state,
.record-title,
.record-note,
.record-side {
  display: block;
}

.header-title {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--primary-deep);
}

.header-subtitle {
  margin-top: 12rpx;
  max-width: 460rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: var(--page-soft);
}

.header-action {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(208, 230, 198, 0.5);
  font-size: 18rpx;
  font-weight: 700;
  color: var(--primary);
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.summary-grid-secondary {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-bottom: 0;
}

.summary-card {
  min-height: 148rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 16rpx 38rpx rgba(27, 28, 21, 0.06);
}

.summary-card-secondary {
  min-height: 132rpx;
  box-shadow: none;
  border: 1rpx solid rgba(194, 201, 187, 0.72);
}

.summary-value {
  font-size: 38rpx;
  line-height: 1.05;
  font-weight: 700;
  color: var(--primary-deep);
}

.summary-value-secondary {
  font-size: 34rpx;
}

.summary-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--page-ink);
}

.summary-note {
  margin-top: 8rpx;
  font-size: 18rpx;
  line-height: 1.5;
  color: var(--page-soft);
}

.chart-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.84);
  box-shadow: 0 16rpx 38rpx rgba(27, 28, 21, 0.06);
}

.chart-head {
  margin-bottom: 18rpx;
}

.chart-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--page-ink);
}

.chart-caption {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: var(--page-soft);
}

.bar-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bar-name {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--page-muted);
}

.bar-track {
  flex: 1;
  height: 16rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(208, 230, 198, 0.42);
}

.bar-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--primary) 0%, #6f8e56 100%);
}

.bar-track-gold {
  background: rgba(243, 226, 185, 0.52);
}

.bar-fill-gold {
  background: linear-gradient(90deg, var(--gold) 0%, #e0c17a 100%);
}

.bar-value {
  min-width: 34rpx;
  text-align: right;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--primary-deep);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(208, 230, 198, 0.34);
}

.tag-name {
  font-size: 20rpx;
  color: var(--page-muted);
}

.tag-value {
  min-width: 28rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(45, 90, 39, 0.12);
  font-size: 18rpx;
  font-weight: 700;
  color: var(--primary-deep);
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(194, 201, 187, 0.72);
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--page-ink);
}

.record-note {
  margin-top: 8rpx;
  font-size: 18rpx;
  line-height: 1.5;
  color: var(--page-soft);
}

.record-side {
  flex-shrink: 0;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(208, 230, 198, 0.34);
  font-size: 18rpx;
  font-weight: 700;
  color: var(--primary);
}

.empty-state {
  padding: 20rpx 0 4rpx;
  font-size: 20rpx;
  color: var(--page-soft);
}
