<view class="page-container planting-dashboard-page">
  <view class="page-aura aura-left"></view>
  <view class="page-aura aura-right"></view>

  <view class="topbar">
    <view class="nav-ghost" bindtap="onBack">
      <text class="nav-ghost-arrow">‹</text>
    </view>
    <text class="brand-title">数据看板</text>
    <view class="profile-chip" bindtap="onProfileClick">
      <text class="profile-name">{{usernameRaw}}</text>
      <text class="profile-role">{{roleLabel}}</text>
    </view>
  </view>

  <!-- 将环节标签移回顶部，匹配原始界面 -->
  <view class="chart-card" wx:if="{{tagItems.length}}">
    <view class="chart-head">
      <text class="chart-title">{{tagSectionTitle}}</text>
      <text class="chart-caption">{{tagSectionCaption}}</text>
    </view>
    <view class="tag-list">
      <block wx:for="{{tagItems}}" wx:key="name">
        <view class="tag-item">
          <text class="tag-name">{{item.name}}</text>
          <text class="tag-value">{{item.value}}</text>
        </view>
      </block>
    </view>
  </view>


  <view class="header">
        <text class="desc">{{dashboardDesc}}</text>
  </view>

  <view class="section-head">
    <text class="section-title">概览</text>
    <view class="section-action" bindtap="loadStats">
      <text>{{loading ? '同步中' : '刷新数据'}}</text>
    </view>
  </view>

  <view class="summary-grid">
    <block wx:for="{{summaryCards}}" wx:key="key">
      <view class="summary-card">
        <text class="summary-value">{{item.value}}</text>
        <text class="summary-label">{{item.label}}</text>
        <text class="summary-note">{{item.note}}</text>
      </view>
    </block>
  </view>

  <view class="chart-card" wx:if="{{insightCards.length}}">
    <view class="chart-head">
      <text class="chart-title">{{insightTitle}}</text>
      <text class="chart-caption">{{insightCaption}}</text>
    </view>
    <view class="summary-grid summary-grid-secondary">
      <block wx:for="{{insightCards}}" wx:key="key">
        <view class="summary-card summary-card-secondary">
          <text class="summary-value summary-value-secondary">{{item.value}}</text>
          <text class="summary-label">{{item.label}}</text>
          <text class="summary-note">{{item.note}}</text>
        </view>
      </block>
    </view>
  </view>

  <block wx:for="{{distSections}}" wx:for-item="section" wx:key="title">
    <view class="chart-card">
      <view class="chart-head">
        <text class="chart-title">{{section.title}}</text>
        <text class="chart-caption">{{section.caption}}</text>
      </view>
      <view class="bar-list" wx:if="{{section.items.length}}">
        <block wx:for="{{section.items}}" wx:for-item="bar" wx:key="name">
          <view class="bar-row">
            <text class="bar-name">{{bar.name}}</text>
            <view class="bar-track {{section.tone === 'warm' ? 'bar-track-gold' : ''}}">
              <view class="bar-fill {{section.tone === 'warm' ? 'bar-fill-gold' : ''}}" style="width: {{bar.percent}}%;"></view>
            </view>
            <text class="bar-value">{{bar.value}}</text>
          </view>
        </block>
      </view>
      <view class="empty-state" wx:else>{{section.emptyText}}</view>
    </view>
  </block>



  <!-- 原位删除，准备移到末尾 -->

  <!-- 原位删除，准备移到末尾 -->

  <view class="chart-card">
    <view class="chart-head">
      <text class="chart-title">{{chainSectionTitle}}</text>
      <text class="chart-caption">{{chainSectionCaption}}</text>
    </view>
    <view class="record-list" wx:if="{{chainRecords.length}}">
      <block wx:for="{{chainRecords}}" wx:key="txHash">
        <view class="record-row">
          <view class="record-main">
            <text class="record-title">{{item.title}}</text>
            <text class="record-note">{{item.note}}</text>
          </view>
          <text class="record-side">{{item.side}}</text>
        </view>
      </block>
    </view>
    <view class="empty-state" wx:else>{{chainEmptyText}}</view>
  </view>

  <!-- 移动到页面底部，防止 Native 组件向上偏移覆盖上方卡片 -->
  <!-- 模块一：全域总产值推演 (宏观) -->
  <view class="chart-card" style="padding-bottom: 20px; margin-top: 20rpx;">
    <view class="chart-head">
      <view>
        <text class="chart-title">县域/企业总产值动态推演 (宏观模型)</text>
        <text class="chart-caption" style="color: #FFCA28;">全域整合精度: 95.6%</text>
      </view>
    </view>
    <view style="width: 100%; height: 200px; overflow: hidden;" wx:if="{{macroForecast}}">
        <canvas id="fc_v6_macro_legacy" canvas-id="fc_v6_macro_legacy" style="width: 100%; height: 200px; display: block;"></canvas>
    </view>
    <view style="width: 100%; height: 200px; display: flex; align-items: center; justify-content: center; background: #f9f9f9;" wx:else>
        <text style="font-size: 20rpx; color: #888;">数据模型加载中...</text>
    </view>
    <view class="chart-legend" style="display: flex; justify-content: center; gap: 12px; font-size: 9px; color: #888; margin-top: 10px;">
        <view style="display: flex; align-items: center;"><view style="width: 8px; height: 2px; background: #2d5a27; margin-right: 3px;"></view>历史产值</view>
        <view style="display: flex; align-items: center;"><view style="width: 8px; height: 2px; border-bottom: 2px dashed #FFCA28; margin-right: 3px;"></view>预测趋势</view>
    </view>
  </view>

  <!-- 模块二：分品种动态推演 (微观) -->
  <view class="chart-card" style="padding-bottom: 20px; margin-top: 20rpx; border: 1rpx solid rgba(45, 90, 39, 0.15); background: rgba(255, 255, 255, 0.95);">
    <view class="chart-head" style="display: flex; justify-content: space-between; align-items: flex-start;">
      <view>
        <text class="chart-title">分品种 AI 动态推演</text>
        <text class="chart-caption" style="color: #4DB6AC;">当前选择: {{herbOptions[herbIndex] || '加载中...'}}</text>
      </view>
      <picker bindchange="onHerbChange" value="{{herbIndex}}" range="{{herbOptions}}">
        <view style="padding: 10rpx 20rpx; background: rgba(45, 90, 39, 0.1); border-radius: 12rpx; font-size: 22rpx; color: #2d5a27; font-weight: bold;">
          切换药材 ▾
        </view>
      </picker>
    </view>
    <view style="width: 100%; height: 200px; overflow: hidden;" wx:if="{{herbForecast}}">
        <canvas id="fc_v6_herb_legacy" canvas-id="fc_v6_herb_legacy" style="width: 100%; height: 200px; display: block;"></canvas>
        <view class="empty-state" wx:if="{{herbLoading}}" style="position: absolute; top: 0; left: 0; width: 100%; height: 200px; background: rgba(255,255,255,0.7); z-index: 10; display: flex; align-items: center; justify-content: center;">
            <text style="font-size: 20rpx; color: #4DB6AC;">AI 神经元计算中...</text>
        </view>
    </view>
    <view class="chart-legend" style="display: flex; justify-content: center; gap: 12px; font-size: 9px; color: #888; margin-top: 10px;">
        <view style="display: flex; align-items: center;"><view style="width: 8px; height: 2px; background: #2d5a27; margin-right: 3px;"></view>历史产值</view>
        <view style="display: flex; align-items: center;"><view style="width: 8px; height: 2px; border-bottom: 2px dashed #4DB6AC; margin-right: 3px;"></view>品种预测</view>
    </view>
  </view>
</view>
