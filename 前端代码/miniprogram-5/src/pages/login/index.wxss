.login-page {
  justify-content: flex-start;
  padding-top: 48rpx;
}

.login-topbar {
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr) 64rpx;
  align-items: center;
  gap: 16rpx;
  margin: 0 -24rpx 28rpx;
  padding: calc(env(safe-area-inset-top) + 8rpx) 24rpx 18rpx;
}

.login-topbar .brand-title {
  margin: 0;
  font-size: 32rpx;
  text-align: center;
}

.login-topbar .profile-chip-placeholder {
  width: 64rpx;
  min-width: 64rpx;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.login-topbar .topbar-spacer {
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
}

.login-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin: 0 0 28rpx;
  position: relative;
  z-index: 1;
}

.logo-icon {
  width: 132rpx;
  height: 132rpx;
  margin-bottom: 22rpx;
}

.login-brand-title,
.login-brand-desc {
  display: block;
}

.login-brand-title {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--primary-deep);
}

.login-brand-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--page-soft);
}

.login-card,
.login-config-card {
  margin-bottom: 18rpx;
  position: relative;
  z-index: 1;
}

.login-card-head {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.login-card-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.login-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary-deep);
}

.login-card-subtitle {
  font-size: 22rpx;
  color: var(--page-soft);
  line-height: 1.55;
}

.picker-inner {
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: var(--surface-soft);
  border: 1rpx solid rgba(194, 201, 187, 0.3);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.picker-value {
  font-size: 24rpx;
  color: var(--page-ink);
}

.picker-arrow {
  font-size: 24rpx;
  color: var(--page-soft);
}

.login-remember-row {
  margin-top: 18rpx;
  margin-bottom: 24rpx;
}

.login-agreement {
  text-align: center;
}

.login-footer {
  margin: 16rpx 0 42rpx;
  text-align: center;
  color: var(--page-soft);
  font-size: 22rpx;
  position: relative;
  z-index: 1;
}
