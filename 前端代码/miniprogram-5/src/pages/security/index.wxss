.security-icon-row {
  margin-bottom: 18rpx;
}

.security-icon-badge {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(250, 248, 236, 0.9);
  border: 1rpx solid rgba(141, 155, 131, 0.14);
  box-shadow: 0 12rpx 28rpx rgba(78, 95, 66, 0.06);
}

.security-icon {
  position: relative;
  width: 40rpx;
  height: 46rpx;
}

.security-icon-core {
  position: absolute;
  inset: 0;
  border-radius: 12rpx 12rpx 16rpx 16rpx;
  background: linear-gradient(180deg, #6f845d 0%, #586b49 100%);
  clip-path: polygon(50% 0%, 92% 16%, 92% 54%, 50% 100%, 8% 54%, 8% 16%);
}

.security-icon-tick {
  position: absolute;
  left: 12rpx;
  top: 18rpx;
  width: 16rpx;
  height: 8rpx;
  border-left: 4rpx solid rgba(250, 248, 236, 0.96);
  border-bottom: 4rpx solid rgba(250, 248, 236, 0.96);
  transform: rotate(-45deg);
}

.security-icon-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.security-icon-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #405038;
  letter-spacing: 1rpx;
}

.security-result-box {
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(245, 244, 232, 0.96);
  border: 1rpx solid rgba(128, 141, 121, 0.12);
}

.security-result-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: #384234;
  font-family: monospace;
  word-break: break-all;
}
