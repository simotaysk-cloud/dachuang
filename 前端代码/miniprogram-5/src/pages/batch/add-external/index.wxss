.external-uploader {
  width: 100%;
  height: 300rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(245, 244, 232, 0.96);
  border: 1rpx solid rgba(128, 141, 121, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.external-preview-img {
  width: 100%;
  height: 100%;
}

.external-upload-placeholder {
  text-align: center;
}

.external-upload-plus {
  font-size: 46rpx;
  line-height: 1;
  margin-bottom: 10rpx;
  color: #486640;
}

.external-upload-text {
  font-size: 22rpx;
  color: #707867;
}
