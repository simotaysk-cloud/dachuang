<view class="page-container  lineage-page">
    <view class="page-aura aura-left"></view>
    <view class="page-aura aura-right"></view>

    <view class="topbar">
        <view class="nav-ghost" bindtap="onBack">
            <text class="nav-ghost-arrow">‹</text>
        </view>
        <text class="brand-title">派生批次详情</text>
        <view class="profile-chip">
            <text class="profile-name">{{usernameRaw}}</text>
            <text class="profile-role">{{roleLabel}}</text>
        </view>
    </view>

    <view class="header">
        <text class="desc">查看该派生批次在当前节点的加工信息和来源关系。</text>
    </view>

    <view class="">
        <view class="hero-panel hero-panel-warning">
            <view class="hero-pattern"></view>
            <text class="hero-title">{{info.childBatchNo || '-'}}</text>
            <text class="hero-subtitle">阶段：{{info.stage || '未知阶段'}}</text>
        </view>

        <view class="card">
            <view class="section-title">加工信息</view>
            <view class="readonly-row">
                <view class="readonly-label">工艺类型</view>
                <view class="readonly-value">{{info.processType || '-'}}</view>
            </view>
            <view class="readonly-row lineage-readonly">
                <view class="readonly-label">生产产线</view>
                <view class="readonly-value">{{info.lineName || '-'}}</view>
            </view>
            <view class="readonly-row lineage-readonly">
                <view class="readonly-label">操作人员</view>
                <view class="readonly-value">{{info.operator || '-'}}</view>
            </view>
            <view class="readonly-row lineage-readonly">
                <view class="readonly-label">操作时间</view>
                <view class="readonly-value">{{info.createdAtFormatted || '-'}}</view>
            </view>
        </view>

        <view class="card">
            <view class="section-title">详细描述</view>
            <view class="lineage-desc-box">
                <text class="lineage-desc-text">{{info.details || '暂无描述'}}</text>
            </view>
        </view>

        <view class="card">
            <view class="section-title">来源信息</view>
            <view class="readonly-row">
                <view class="readonly-label">父批次号</view>
                <view class="readonly-value lineage-mono">{{info.parentBatchNo || '-'}}</view>
            </view>
        </view>
    </view>
</view>
