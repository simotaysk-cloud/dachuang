<view class="page-container  planting-form-page">
    <view class="page-aura aura-left"></view>
    <view class="page-aura aura-right"></view>

    <view class="topbar">
        <view class="nav-ghost" bindtap="onBack">
            <text class="nav-ghost-arrow">‹</text>
        </view>
        <text class="brand-title">{{id ? '编辑记录' : '新增记录'}}</text>
        <view class="profile-chip">
            <text class="profile-name">{{usernameRaw}}</text>
            <text class="profile-role">{{roleLabel}}</text>
        </view>
    </view>

    <view class="header">
        <text class="desc">关键田间操作会自动获取定位，也支持图片和语音留痕。</text>
    </view>

    <view class="">
        <view class="hero-panel hero-panel-warning">
            <view class="hero-pattern"></view>
            <text class="hero-title">{{form.batchNo || '未关联批次'}}</text>
            <text class="hero-subtitle">{{manualTime ? operationTimeText : '未手动设置时间，保存时自动记录当前时间。'}}</text>
        </view>

        <view class="card">
            <view class="section-title">基本信息</view>
            <view class="readonly-row" wx:if="{{form.id}}">
                <view class="readonly-label">记录 ID</view>
                <view class="readonly-value">#{{form.id}}</view>
            </view>

            <view class="sub-title">操作时间</view>
            <view class="picker-row">
                <view class="picker-label">手动设置</view>
                <switch checked="{{manualTime}}" bindchange="onManualTimeChange" />
            </view>
            <text class="meta" wx:if="{{!manualTime}}">不手动设置时：保存时记录当前时间</text>

            <view wx:if="{{manualTime}}">
                <picker mode="date" value="{{operationDate}}" bindchange="onOperationDateChange">
                    <view class="picker-row planting-picker">
                        <view class="picker-label">日期</view>
                        <view class="picker-value">{{operationDate}}</view>
                    </view>
                </picker>
                <picker mode="time" value="{{operationClock}}" bindchange="onOperationClockChange">
                    <view class="picker-row planting-picker">
                        <view class="picker-label">时间</view>
                        <view class="picker-value">{{operationClock}}</view>
                    </view>
                </picker>
                <text class="meta">当前选择：{{operationTimeText}}</text>
            </view>

            <view class="readonly-row planting-readonly">
                <view class="readonly-label">批次号</view>
                <view class="readonly-value">{{form.batchNo}}</view>
            </view>

            <view class="field-label">地块名称</view>
            <input class="input" placeholder="例如：一号地块" value="{{form.fieldName}}" data-field="fieldName" bindinput="onInput" />

            <view class="sub-title">操作类型</view>
            <view class="chip-row">
                <view class="chip {{selectedOperation === item ? 'chip-active' : ''}}" wx:for="{{operationOptions}}" wx:key="*this" data-value="{{item}}" bindtap="selectOperation">
                    {{item}}
                </view>
            </view>

            <view wx:if="{{selectedOperation === '其他'}}">
                <view class="field-label">自定义操作类型</view>
                <input class="input" placeholder="例如：病虫害排查" value="{{customOperation}}" bindinput="onCustomOperationInput" />
            </view>

            <view class="field-label">操作人（可改）</view>
            <input class="input" placeholder="例如：张三" value="{{form.operator}}" data-field="operator" bindinput="onInput" />

            <view class="field-label">详细描述</view>
            <textarea class="textarea" placeholder="可选：用量、天气、备注等" value="{{form.details}}" data-field="details" bindinput="onInput" />
        </view>

        <view class="card">
            <view class="section-title">证据与定位</view>

            <view class="field-label">定位（关键操作必填）</view>
            <text class="meta" wx:if="{{form.latitude && form.longitude}}">已获取：{{form.latitude}}, {{form.longitude}}</text>
            <text class="meta" wx:if="{{!form.latitude || !form.longitude}}">定位会自动获取（如果失败请检查定位权限）</text>

            <view class="field-label">图片（可选）</view>
            <view class="action-row">
                <button class="btn btn-outline" bindtap="chooseImage">选择图片</button>
                <button class="btn btn-outline" wx:if="{{imageFilePath || form.imageUrl}}" bindtap="previewImage">预览</button>
            </view>
            <button class="btn btn-warn single-action" wx:if="{{imageFilePath || form.imageUrl}}" bindtap="clearImage">清除图片</button>
            <text class="meta" wx:if="{{imageFilePath}}">已选择：本地图片</text>
            <text class="meta" wx:if="{{!imageFilePath && form.imageUrl}}">已保存：{{form.imageUrl}}</text>

            <view class="field-label">语音（可选）</view>
            <view class="action-row planting-audio-grid">
                <button class="btn btn-outline" bindtap="chooseAudio">选择音频</button>
                <button class="btn btn-outline" wx:if="{{!recording}}" bindtap="startRecord">开始录音</button>
                <button class="btn btn-warn" wx:if="{{recording}}" bindtap="stopRecord">停止录音</button>
                <button class="btn btn-warn" wx:if="{{audioFilePath || form.audioUrl}}" bindtap="clearAudio">清除音频</button>
            </view>
            <text class="meta" wx:if="{{recording}}">录音中...</text>
            <text class="meta" wx:if="{{audioFilePath}}">已录音：本地音频</text>
            <text class="meta" wx:if="{{!audioFilePath && form.audioUrl}}">已保存：{{form.audioUrl}}</text>
            <text class="meta" wx:if="{{uploading}}">附件上传中...</text>
        </view>

        <view class="card">
            <view class="section-title">操作</view>
            <view class="action-row">
                <button class="btn btn-primary" bindtap="save">保存</button>
                <button class="btn btn-outline" bindtap="cancel">取消</button>
            </view>
            <button class="btn btn-warn single-action" wx:if="{{form.id}}" bindtap="remove">删除</button>
        </view>
    </view>
</view>
