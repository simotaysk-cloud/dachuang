.processing-page {
  padding-bottom: 40rpx;
}

/* 扫码开工核心区 */
.proc-hero-section {
  padding: 40rpx;
  background: linear-gradient(135deg, rgba(46, 125, 50, 0.05), rgba(77, 182, 172, 0.05));
}

.scan-area {
  background: var(--primary-color);
  padding: 40rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 30rpx;
  box-shadow: 0 16rpx 32rpx rgba(46, 125, 50, 0.2);
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

.scan-visual {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.scan-icon {
  font-size: 50rpx;
}

.scan-line {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: #fff;
  box-shadow: 0 0 15rpx #fff;
  animation: scanMove 2s infinite ease-in-out;
}

@keyframes scanMove {
  0% { top: 10%; }
  50% { top: 90%; }
  100% { top: 10%; }
}

.scan-text .main-text {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}

.scan-text .sub-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 6rpx;
}

.btn-grid-secondary {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

/* 列表特殊处理 */
.section-divider {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.count-badge {
  background: var(--surface-muted);
  color: var(--text-sub);
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.proc-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.proc-main {
  flex: 1;
}

.proc-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.tag-cyan {
  background: rgba(77, 182, 172, 0.1);
  color: var(--secondary-cyan);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.proc-meta .meta-row {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

.proc-right {
  text-align: right;
}

.proc-quantity {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.proc-quantity .unit {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-light);
  margin-left: 4rpx;
}

.trace-link {
  font-size: 20rpx;
  color: var(--secondary-cyan);
  margin-top: 10rpx;
  font-weight: 500;
}

.empty-icon-box {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

