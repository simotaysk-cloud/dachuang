<view class="page-container external-reg-page">
    <view class="ink-blob-top"></view>
    
    <view class="header">
        <view class="title">外源原料登记</view>
        <view class="desc">登记采购原料批次并上传存证信息</view>
    </view>

    <view class="card glass-card">
        <view class="section-divider">
            <view class="section-title">登记身份档案</view>
            <view class="safe-tag">🛡️ 安全准入</view>
        </view>
        <view class="form-hint">请录入真实的供应商信息与实景凭证</view>

        <view class="form-group">
            <view class="input-label-row">
                <text class="i-label">药材名称</text>
                <text class="i-req">*</text>
            </view>
            <input class="input" placeholder="请输入完整药材名" value="{{form.name}}" data-field="name" bindinput="onInput" />
        </view>

        <view class="form-grid">
            <view class="form-group">
                <text class="i-label">所属类别</text>
                <input class="input" placeholder="如：根茎类" value="{{form.category}}" data-field="category" bindinput="onInput" />
            </view>
            <view class="form-group">
                <text class="i-label">产地/来源</text>
                <input class="input" placeholder="产地信息" value="{{form.origin}}" data-field="origin" bindinput="onInput" />
            </view>
        </view>

        <view class="form-grid">
            <view class="form-group">
                <text class="i-label">入库数量</text>
                <input class="input" type="digit" placeholder="数值" value="{{form.quantity}}" data-field="quantity" bindinput="onInput" />
            </view>
            <view class="form-group">
                <text class="i-label">计量单位</text>
                <input class="input" placeholder="单位" value="{{form.unit}}" data-field="unit" bindinput="onInput" />
            </view>
        </view>

        <view class="form-group">
            <view class="input-label-row">
                <text class="i-label">实景凭证 (进货票据/原材照片)</text>
                <text class="i-req">*</text>
            </view>
            <view class="image-uploader-modern" bindtap="chooseImage">
                <image wx:if="{{form.imageUrl}}" class="preview-img" src="{{form.imageUrl}}" mode="aspectFill" />
                <view wx:else class="upload-placeholder">
                    <view class="u-icon">+</view>
                    <view class="u-text">点击上传证照</view>
                </view>
            </view>
        </view>

        <view class="form-group">
            <text class="i-label">备注 (供应商及批次说明)</text>
            <textarea class="textarea-modern" placeholder="详细填写供应商信息..." value="{{form.description}}" data-field="description" bindinput="onInput" />
        </view>

        <view class="btn-group-action">
            <button class="btn btn-primary btn-hero" bindtap="save">完成并提交登记</button>
        </view>
    </view>
</view>
