.external-reg-page {
  padding-bottom: 50rpx;
}

/* 顶部墨晕 */
.ink-blob-top {
  position: absolute;
  top: -100rpx;
  right: -50rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(77, 182, 172, 0.04) 0%, transparent 70%);
  filter: blur(40px);
  z-index: -1;
}

.safe-tag {
  font-size: 20rpx;
  color: #2E7D32;
  background: rgba(46, 125, 50, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.form-hint {
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 40rpx;
}

.form-group {
  margin-bottom: 30rpx;
}

.input-label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.i-label {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 600;
}

.i-req {
  color: #e53935;
  font-size: 28rpx;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

/* 现代上传器 */
.image-uploader-modern {
  width: 100%;
  height: 380rpx;
  background: rgba(0,0,0,0.02);
  border: 2rpx dashed var(--border-color);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  text-align: center;
}

.u-icon {
  font-size: 60rpx;
  color: var(--text-light);
  margin-bottom: 10rpx;
}

.u-text {
  font-size: 24rpx;
  color: var(--text-light);
}

.textarea-modern {
  width: 100%;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.4);
  border: 2rpx solid var(--border-color);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.btn-group-action {
  margin-top: 50rpx;
  padding-bottom: 20rpx;
}