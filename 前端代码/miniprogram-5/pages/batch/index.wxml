<view class="page-container batch-page">
    <supply-chain-steps active="{{currentStepIdx}}" />
    <view class="header">
        <view class="title">批次管理</view>
        <view class="desc">中药材溯源身份与全生命周期档案</view>
    </view>

    <!-- 列表展示 -->
    <view class="card glass-card">
        <view class="section-title">批次列表</view>
        
        <view class="search-section">
            <view class="search-bar">
                <input class="input-inline" placeholder="输入药材名或批次号查询" value="{{queryNo}}" bindinput="onQueryInput" />
                <button class="btn-small search-btn" bindtap="query">立即查询</button>
            </view>
        </view>

        <view class="action-grid">
            <button class="btn btn-primary" bindtap="startCreate" wx:if="{{role === 'ADMIN'}}">
                + 新建生产批次
            </button>
            <button class="btn btn-outline" bindtap="listAll">同步数据</button>
        </view>

        <!-- 列表内容 -->
        <view class="list-container" wx:if="{{batches && batches.length > 0}}">
            <view class="batch-item glass-card" wx:for="{{batches}}" wx:key="id" bindtap="editFromList" data-item="{{item}}">
                <view class="batch-main">
                    <view class="batch-title">
                        <text class="tag-primary">药材</text>
                        {{item.name}}
                    </view>
                    <view class="batch-info">
                        <view class="info-row">
                            <text class="label">批次编号：</text>
                            <text class="value">{{item.batchNo}}</text>
                        </view>
                        <view class="info-row">
                            <text class="label">原产地：</text>
                            <text class="value">{{item.origin || '待完善'}}</text>
                        </view>
                    </view>
                    <view class="batch-footer">
                        <view class="stock-info" wx:if="{{item.quantity}}">
                            可用库存: <text class="stock-value">{{item.quantity}} {{item.unit}}</text>
                        </view>
                        <view class="status-tag locked" wx:if="{{item.gs1Locked}}">
                            <icon type="success" size="12" color="#2E7D32"></icon>
                            数字化身份已锁定
                        </view>
                    </view>
                </view>
                <view class="arrow-icon">></view>
            </view>
        </view>
        
        <view class="empty-state" wx:if="{{(!batches || batches.length === 0) && !loading}}">
            <image src="/assets/logo.png" mode="aspectFit" class="empty-img"></image>
            <view>暂无相关的批次档案数据</view>
        </view>
    </view>

    <!-- 二维码弹窗 -->
    <view class="modal-mask" wx:if="{{showQrModal}}" bindtap="hideQrModal">
        <view class="modal glass-card batch-modal-center" catchtap="return">
            <view class="modal-title">溯源二维码</view>
            <view class="qr-box">
                <image class="qr-image" src="data:image/png;base64,{{qrCodeBase64}}" mode="aspectFit" />
            </view>
            <view class="batch-no-display">{{currentBatchNo}}</view>
            <view class="modal-actions">
                <button class="btn btn-primary" bindtap="saveQrCode">保存到系统相册</button>
                <button class="btn btn-outline" bindtap="hideQrModal">关闭</button>
            </view>
        </view>
    </view>

    <!-- 编辑/新增表单弹窗 -->
    <view class="modal-mask" wx:if="{{showForm}}">
        <view class="modal glass-card modal-scroll" catchtap="return">
            <view class="modal-title">{{form.id ? '药材批次档案' : '录入新批次'}}</view>
            
            <!-- 批次流转进度指示器 -->
            <view wx:if="{{form.id}}" class="macro-progress-section" style="padding: 10rpx 0 30rpx 0;">
                <view wx:if="{{formLoadingTrace}}" style="text-align: center; font-size: 24rpx; color: #999; padding: 20rpx;">
                    正在同步后端链上数据...
                </view>
                <view wx:else style="margin: 0 -20rpx; transform: scale(0.9); transform-origin: top center;">
                    <supply-chain-steps mode="process" active="{{formProcessStepIdx}}" bind:stepClick="viewTrace" />
                </view>
            </view>
            
            <view class="form-section">
                <view class="readonly-row" wx:if="{{form.id}}">
                    <view class="readonly-label">系统内部识别码</view>
                    <view class="readonly-value">#{{form.id}}</view>
                </view>

                <view class="field-label">批次编号 (由系统自动分配)</view>
                <input class="input" placeholder="自动生成" value="{{form.batchNo}}" disabled="{{true}}" />

                <view class="field-label">药材通用名</view>
                <input class="input" placeholder="例如：当归 / 人参" value="{{form.name}}" data-field="name" bindinput="onInput" disabled="{{!!form.id}}" />

                <view class="field-label">药材类别</view>
                <input class="input" placeholder="例如：根茎类 / 叶类" value="{{form.category}}" data-field="category" bindinput="onInput" disabled="{{!!form.id}}" />

                <view class="field-label">产地信息</view>
                <input class="input" placeholder="具体到县/乡/村" value="{{form.origin}}" data-field="origin" bindinput="onInput" disabled="{{!!form.id}}" />

                <view class="sub-title">库存与数字化标识</view>
                <view class="stat-row">
                    <view class="stat-item">
                        <view class="field-label">收获/入库数量</view>
                        <input class="input" type="digit" value="{{form.quantity}}" data-field="quantity" bindinput="onInput" disabled="{{!!form.id}}" />
                    </view>
                    <view class="stat-item">
                        <view class="field-label">计量单位</view>
                        <input class="input" value="{{form.unit}}" data-field="unit" bindinput="onInput" disabled="{{!!form.id}}" />
                    </view>
                </view>

                <view class="tips orange" wx:if="{{form.gs1Locked && !form.id}}">
                    ※ 该批次数字化信息已锁定，不可修改数量与单位
                </view>

                <view class="field-label">产地实景/来源凭证</view>
                <view class="image-uploader-tcm" bindtap="{{form.id ? '' : 'chooseImage'}}">
                    <image wx:if="{{form.imageUrl}}" class="uploader-img" src="{{form.imageUrl}}" mode="aspectFill" />
                    <view wx:else class="uploader-placeholder">
                        <view class="plus">+</view>
                        <view>上传图片</view>
                    </view>
                </view>

                <view class="field-label">补充备注</view>
                <textarea class="textarea" placeholder="关于该批次的其他详细描述..." value="{{form.description}}" data-field="description" bindinput="onInput" disabled="{{!!form.id}}" />
                
                <view class="footer-actions">
                    <block wx:if="{{form.id}}">
                        <button class="btn btn-outline" bindtap="cancelEdit">返回列表</button>
                        <button class="btn btn-primary" bindtap="viewTrace">开启可视化溯源</button>
                    </block>
                    <block wx:else>
                        <button class="btn btn-outline" bindtap="cancelEdit">暂不录入</button>
                        <button class="btn btn-primary" bindtap="save">确认提交</button>
                    </block>
                </view>

                <view wx:if="{{form.id && !form.gs1Locked && role === 'ADMIN'}}" class="lock-section">
                    <button class="btn btn-warn" bindtap="lockGs1">锁定批次信息</button>
                    <view class="lock-hint">锁定后将正式生成防伪条码，数量信息将不可变更</view>
                </view>
            </view>
        </view>
    </view>
</view>
