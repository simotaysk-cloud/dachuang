.inspection-page {
  padding-bottom: 40rpx;
}

/* 墨染背景 */
.ink-blob-top {
  position: absolute;
  top: -150rpx;
  right: -50rpx;
  width: 450rpx;
  height: 450rpx;
  background: radial-gradient(circle, rgba(46, 125, 50, 0.04) 0%, transparent 70%);
  filter: blur(45px);
  z-index: -1;
}

/* 质检英雄区 */
.qc-hero-section {
  padding: 40rpx;
  background: linear-gradient(135deg, rgba(46, 125, 50, 0.03), rgba(0, 150, 136, 0.03));
}

.safe-badge {
  font-size: 22rpx;
  color: #2E7D32;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(46, 125, 50, 0.08);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.qc-scan-box {
  background: var(--primary-color);
  padding: 40rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 30rpx;
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(46, 125, 50, 0.15);
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

.scan-frame {
  width: 130rpx;
  height: 130rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 24rpx;
  position: relative;
  background: rgba(255, 255, 255, 0.1);
}

.scan-bar {
  position: absolute;
  left: 10%;
  top: 20%;
  width: 80%;
  height: 4rpx;
  background: #fff;
  box-shadow: 0 0 15rpx #fff;
  animation: qcScan 2.5s infinite linear;
}

@keyframes qcScan {
  0% { transform: translateY(0); opacity: 1; }
  50% { transform: translateY(90rpx); opacity: 0.8; }
  100% { transform: translateY(0); opacity: 1; }
}

.qc-scan-box .main-label {
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.qc-scan-box .sub-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

/* 质检记录卡片 */
.record-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-left: 8rpx solid var(--border-color);
}

.status-pass {
  border-left-color: #2E7D32;
}

.status-pending {
  border-left-color: #FFA000;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.record-id {
  font-size: 24rpx;
  color: var(--text-light);
  font-family: monospace;
}

.record-result-tag {
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  background: var(--surface-muted);
}

.status-pass .record-result-tag {
  color: #2E7D32;
  background: rgba(46, 125, 50, 0.08);
}

.record-content {
  display: grid;
  gap: 12rpx;
}

.content-item {
  display: flex;
  font-size: 26rpx;
}

.c-label {
  color: var(--text-sub);
  width: 160rpx;
}

.c-value {
  color: var(--text-main);
  font-weight: 500;
}

.record-footer {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
  text-align: right;
}

.view-detail {
  font-size: 22rpx;
  color: var(--secondary-cyan);
  font-weight: 600;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-light);
}

.empty-cert {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.3;
}