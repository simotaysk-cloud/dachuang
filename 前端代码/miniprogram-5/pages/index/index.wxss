.home-page {
  position: relative;
  overflow: hidden;
  padding-bottom: 40rpx;
}

.ink-blob-bottom {
  position: absolute;
  bottom: -200rpx;
  left: -100rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(77, 182, 172, 0.05) 0%, transparent 70%);
  filter: blur(50px);
  z-index: -1;
}

.home-header {
  display: flex;
  align-items: center;
  padding: 40rpx 40rpx 20rpx;
  margin-bottom: 30rpx;
}

.header-logo {
  width: 100rpx;
  height: 100rpx;
  margin-right: 24rpx;
  filter: drop-shadow(0 6rpx 12rpx rgba(46, 125, 50, 0.1));
}

.header-content .title {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--primary-color);
  letter-spacing: 2rpx;
}

.header-content .desc {
  font-size: 22rpx;
  color: var(--text-light);
  margin-top: 4rpx;
}

.user-profile-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx;
  position: relative;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
}

.avatar-circle {
  width: 90rpx;
  height: 90rpx;
  background: linear-gradient(135deg, var(--primary-color), #4db6ac);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(46, 125, 50, 0.2);
  border: 4rpx solid #fff;
}

.avatar-text {
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
  text-transform: uppercase;
}

.user-info-text {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 6rpx;
}

.user-role-badge {
  display: inline-block;
  font-size: 20rpx;
  color: var(--primary-color);
  background: rgba(46, 125, 50, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
  border: 1rpx solid rgba(46, 125, 50, 0.15);
}

.flow-section {
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.supply-chain-flow {
  height: 160rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.flow-nodes {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flow-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 110rpx;
  flex-shrink: 0;
}

.node-dot {
  width: 18rpx;
  height: 18rpx;
  background: #E0E0E0;
  border-radius: 50%;
  border: 4rpx solid #fff;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
  z-index: 5;
}

.flow-node.active .node-dot {
  background: var(--primary-color);
  box-shadow: 0 0 15rpx rgba(46, 125, 50, 0.4);
  transform: scale(1.2);
}

.node-name {
  margin-top: 14rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: var(--text-light);
  white-space: nowrap;
}

.flow-node.active .node-name {
  color: var(--primary-color);
  font-weight: 800;
}

/* 连接线/物流线 */
.flow-connector {
  flex: 1;
  height: 20rpx;
  position: relative;
  display: flex;
  align-items: center;
  margin: 0 -10rpx;
  margin-top: -34rpx; /* 对齐圆点中心 */
}

.connector-line {
  width: 100%;
  height: 3rpx;
  background: rgba(0, 0, 0, 0.04);
  background: linear-gradient(90deg, #E0E0E0, #eee, #E0E0E0);
}

.flow-connector.active .connector-line {
  background: linear-gradient(90deg, #4CAF50, #81C784, #4CAF50);
  background-size: 200% 100%;
  animation: flowMove 2s linear infinite;
}

@keyframes flowMove {
  0% { background-position: 100% 0; }
  100% { background-position: 0% 0; }
}

.connector-arrow {
  position: absolute;
  right: 0;
  width: 8rpx;
  height: 8rpx;
  border-top: 2rpx solid #4CAF50;
  border-right: 2rpx solid #4CAF50;
  transform: rotate(45deg);
}

.stats-grid {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.stat-cell {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  background: rgba(255, 255, 255, 0.4);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  min-width: 0;
}

.stat-info {
  flex: 1;
  min-width: 0;
}

.stat-value {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
  word-break: break-all;
  line-height: 1.3;
}

.stat-label {
  font-size: 20rpx;
  color: var(--text-sub);
}

.menu-section {
  padding: 0 24rpx;
  margin-top: 40rpx;
}

.menu-grid.density-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.menu-item {
  padding: 30rpx 0;
}

.menu-icon-bg {
  width: 100rpx;
  height: 100rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, var(--primary-color), #43A047);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(46, 125, 50, 0.2);
}

.menu-icon-bg.herb {
  background: linear-gradient(135deg, #66BB6A, #2E7D32);
}

.menu-icon-bg.cyan {
  background: linear-gradient(135deg, var(--accent-color), #26A69A);
  box-shadow: 0 8rpx 20rpx rgba(77, 182, 172, 0.2);
}

.menu-icon-bg.blue {
  background: linear-gradient(135deg, #42A5F5, #1976D2);
  box-shadow: 0 8rpx 20rpx rgba(33, 150, 243, 0.2);
}

.menu-icon-bg.mint {
  background: linear-gradient(135deg, #4DB6AC, #00897B);
  box-shadow: 0 8rpx 20rpx rgba(0, 150, 136, 0.2);
}

.menu-icon-bg.security {
  background: linear-gradient(135deg, #5C6BC0, #3949AB);
  box-shadow: 0 8rpx 20rpx rgba(63, 81, 181, 0.2);
}

.menu-icon-bg.gold {
  background: linear-gradient(135deg, #FFB300, #F57C00);
  box-shadow: 0 8rpx 20rpx rgba(255, 179, 0, 0.2);
}

.menu-icon-bg.grey {
  background: linear-gradient(135deg, #78909C, #455A64);
  box-shadow: 0 8rpx 20rpx rgba(96, 125, 139, 0.2);
}

.menu-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  letter-spacing: 1rpx;
}

/* 连接配置增强 */
.config-mini {
  margin: 30rpx 24rpx;
  padding: 24rpx;
}

.mini-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.mini-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-main);
}

.mini-hint {
  font-size: 20rpx;
  color: var(--text-light);
  font-family: monospace;
}

.config-expand {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.btn-mini {
  padding: 0 20rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 22rpx;
  white-space: nowrap;
}


.footer {
  margin-top: 80rpx;
  padding-bottom: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-light);
}
