<view class="page-container home-page">
  <view class="ink-blob-bottom"></view>
  
  <view class="header home-header">
    <image class="header-logo" src="/assets/tcm_herb.png" mode="aspectFit"></image>
    <view class="header-content">
      <view class="title">智汇本草</view>
      <view class="desc">中药材全过程数字化溯源平台</view>
    </view>
  </view>

  <!-- 供应链全流程可视化 -->
  <view class="flow-section" wx:if="{{token}}">
    <view class="supply-chain-flow glass-card">
      <view class="flow-nodes">
        <block wx:for="{{flowNodes}}" wx:key="id">
          <!-- 节点 -->
          <view class="flow-node {{item.active ? 'active' : ''}}">
            <view class="node-dot"></view>
            <view class="node-name">{{item.name}}</view>
          </view>
          <!-- 连接线 (物流) - 最后一个节点后不需要 -->
          <view class="flow-connector {{logisticsActive ? 'active' : ''}}" wx:if="{{index < 4}}">
            <view class="connector-line"></view>
            <view class="connector-arrow" wx:if="{{logisticsActive}}"></view>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 概览看板 -->
  <view class="card glass-card overview-card">
    <view class="section-title">实时概览</view>
    <view class="stats-grid">
      <view class="stat-cell">
        <view class="stat-icon green-dot"></view>
        <view class="stat-info">
          <view class="stat-value">{{healthStatus}}</view>
          <view class="stat-label">服务状态</view>
        </view>
      </view>
      <view class="stat-cell">
        <view class="stat-icon login-dot {{token ? 'active' : ''}}"></view>
        <view class="stat-info">
          <view class="stat-value">{{token ? username : '待登录'}}</view>
          <view class="stat-label">{{token ? roleName : '身份认证'}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能导航组 -->
  <view class="menu-section">
    <view class="section-title">智慧管理</view>
    <view class="menu-grid density-3">
      <view class="menu-item glass-card" bindtap="navTo" data-url="/pages/planting/index" wx:if="{{menuAccess.planting}}">
        <view class="menu-icon-bg herb">
          <view class="icon-inner">种</view>
        </view>
        <view class="menu-label">种植管理</view>
      </view>
      
      <view class="menu-item glass-card" bindtap="navTo" data-url="/pages/batch/index" wx:if="{{menuAccess.batch}}">
        <view class="menu-icon-bg">
          <view class="icon-inner">批</view>
        </view>
        <view class="menu-label">批次档案</view>
      </view>
      
      <view class="menu-item glass-card" bindtap="navTo" data-url="/pages/processing/index" wx:if="{{menuAccess.processing}}">
        <view class="menu-icon-bg cyan">
          <view class="icon-inner">加</view>
        </view>
        <view class="menu-label">加工生产</view>
      </view>

      <view class="menu-item glass-card" bindtap="navTo" data-url="/pages/logistics/index" wx:if="{{menuAccess.logistics}}">
        <view class="menu-icon-bg blue">
          <view class="icon-inner">运</view>
        </view>
        <view class="menu-label">物流追踪</view>
      </view>

      <view class="menu-item glass-card" bindtap="navTo" data-url="/pages/inspection/index" wx:if="{{menuAccess.inspection}}">
        <view class="menu-icon-bg cyan">
          <view class="icon-inner">检</view>
        </view>
        <view class="menu-label">质量检测</view>
      </view>

      <view class="menu-item glass-card" bindtap="navTo" data-url="/pages/terminal-qrcode/index" wx:if="{{menuAccess.terminalQrcode}}">
        <view class="menu-icon-bg mint">
          <view class="icon-inner">终</view>
        </view>
        <view class="menu-label">终端溯源</view>
      </view>

      <view class="menu-item glass-card" bindtap="navTo" data-url="/pages/security/index" wx:if="{{menuAccess.security}}">
        <view class="menu-icon-bg security">
          <view class="icon-inner">防</view>
        </view>
        <view class="menu-label">防伪管理</view>
      </view>

      <view class="menu-item glass-card" bindtap="navTo" data-url="/pages/web-dashboard/index" wx:if="{{menuAccess.dashboard}}">
        <view class="menu-icon-bg gold">
          <view class="icon-inner">看</view>
        </view>
        <view class="menu-label">数据看板</view>
      </view>

      <view class="menu-item glass-card" bindtap="navTo" data-url="/pages/user-mgmt/index" wx:if="{{menuAccess.userMgmt}}">
        <view class="menu-icon-bg grey">
          <view class="icon-inner">权</view>
        </view>
        <view class="menu-label">系统权限</view>
      </view>
    </view>
  </view>

  <!-- 扩展功能 -->
  <view class="card glass-card config-mini">
    <view class="mini-header" bindtap="toggleConfig">
        <text class="mini-title">后端连接配置</text>
        <text class="mini-hint">{{baseUrl}}</text>
    </view>
    <view class="config-expand" wx:if="{{configExpanded}}">
      <input class="input-inline" placeholder="请输入服务器IP:端口" value="{{baseUrl}}" bindinput="onBaseUrlInput" />
      <button class="btn btn-primary btn-mini" bindtap="saveBaseUrlAndCheck">同步连接</button>
    </view>
  </view>

  <view class="footer">© 2026 智汇本草 · 数字化中药材溯源系统支持</view>
</view>
