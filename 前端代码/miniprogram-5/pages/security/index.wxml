<view class="page-container security-page">
    <view class="ink-blob-top"></view>
    
    <view class="header">
        <view class="title">防伪管理</view>
        <view class="desc">基于区块链技术的双码校验与数据加密核验</view>
    </view>

    <!-- 核心防伪技术 -->
    <view class="card glass-card">
        <view class="section-divider">
            <view class="section-title">双码防伪认证</view>
            <view class="safe-tag">🛡️ 专利加密</view>
        </view>
        <view class="form-hint">通过关联批次号生成唯一的防伪加密双码</view>
        
        <view class="form-group">
            <view class="i-label">批次存证编号</view>
            <input class="input" placeholder="请输入受控批次号" value="{{batchNo}}" bindinput="onBatchInput" />
            <button class="btn btn-primary btn-hero-mini" bindtap="generate">签发防伪标识</button>
        </view>

        <view class="form-group divider-top">
            <view class="i-label">隐形码效力核验</view>
            <input class="input" placeholder="输入待核验的识别码" value="{{invisibleCode}}" bindinput="onCodeInput" />
            <button class="btn btn-outline" bindtap="verify">立即比对待校验值</button>
        </view>
    </view>

    <!-- 区块链底层支持 -->
    <view class="card glass-card">
        <view class="section-divider">
            <view class="section-title">至信链数据存证</view>
            <view class="chain-badge">⛓️ 全节点连接</view>
        </view>
        
        <view class="form-group">
            <view class="i-label">存证附加摘要</view>
            <input class="input" placeholder="输入上链备注数据 (可选)" value="{{bcData}}" bindinput="onBCDataInput" />
        </view>

        <view class="action-grid-security">
            <button class="btn btn-primary" bindtap="recordBC">触发数据上链</button>
            <button class="btn btn-outline" bindtap="queryBC">查询链上特征</button>
        </view>
        
        <button class="btn btn-outline btn-full" style="margin-top: 20rpx;" bindtap="verifyBC">完整性一致性验证</button>
    </view>

    <!-- 校验回馈 -->
    <view class="card glass-card result-panel" wx:if="{{result}}">
        <view class="section-title">实时核验回馈</view>
        <view class="result-box">
            <text class="result-text">{{result}}</text>
        </view>
    </view>
</view>
