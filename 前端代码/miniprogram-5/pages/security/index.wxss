.security-page {
  padding-bottom: 40rpx;
}

.ink-blob-top {
  position: absolute;
  top: -120rpx;
  right: -80rpx;
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, rgba(92, 107, 192, 0.05) 0%, transparent 70%);
  filter: blur(40px);
  z-index: -1;
}

.safe-tag {
  font-size: 18rpx;
  color: var(--primary-color);
  background: rgba(46, 125, 50, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.chain-badge {
  font-size: 18rpx;
  color: #3949AB;
  background: rgba(57, 73, 171, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.form-hint {
  font-size: 24rpx;
  color: var(--text-light);
  margin-bottom: 30rpx;
}

.form-group {
  margin-bottom: 30rpx;
}

.i-label {
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 600;
  margin-bottom: 12rpx;
  display: block;
}

.divider-top {
  border-top: 1rpx solid var(--border-color);
  padding-top: 30rpx;
}

.btn-hero-mini {
  margin-top: 10rpx;
}

.action-grid-security {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.btn-full {
  width: 100%;
}

/* 结果面板 */
.result-panel {
  background: rgba(46, 125, 50, 0.02);
  border: 1rpx solid rgba(46, 125, 50, 0.1);
}

.result-box {
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border-color);
  min-height: 100rpx;
}

.result-text {
  font-size: 24rpx;
  color: var(--text-main);
  font-family: monospace;
  word-break: break-all;
  line-height: 1.5;
}
