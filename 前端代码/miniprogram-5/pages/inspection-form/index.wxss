/* pages/inspection-form/index.wxss */
/* Common styles are in app.wxss */

.input-locked {
  background: #f5f5f5;
  color: #666;
}

.type-selector {
  display: flex;
  margin-bottom: 30rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  padding: 6rpx;
}
.type-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 8rpx;
  transition: all 0.2s;
}
.type-item.active {
  background: #fff;
  color: #1296db;
  font-weight: bold;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.05);
}
