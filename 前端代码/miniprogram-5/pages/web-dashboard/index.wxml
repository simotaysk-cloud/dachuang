<view class="page-container dashboard-page">
  <view class="node-bg"></view>
  
  <view class="header">
    <view class="title">数据看板</view>
    <view class="desc">中药材溯源全链条核心指标监控</view>
  </view>

  <!-- 上链核心统计 -->
  <view class="card glass-card metrics-section">
    <view class="section-divider">
        <view class="section-title">全域核心指标</view>
        <view class="trace-badge">数字化溯源率: <text class="highlight">{{traceabilityRateText}}%</text></view>
    </view>
    <view class="metrics-grid">
      <view class="metric-item">
        <view class="metric-value">{{stats.totalBatches}}</view>
        <view class="metric-label">档案总批次</view>
      </view>
      <view class="metric-item">
        <view class="metric-value">{{stats.totalTerminalQrcodes}}</view>
        <view class="metric-label">防伪二维码</view>
      </view>
      <view class="metric-item">
        <view class="metric-value">{{stats.totalProcessingRecords}}</view>
        <view class="metric-label">加工生产数</view>
      </view>
      <view class="metric-item">
        <view class="metric-value">{{stats.totalShipments}}</view>
        <view class="metric-label">物流发运单</view>
      </view>
    </view>
    <button class="btn btn-mini-outline sync-btn" bindtap="loadStats" loading="{{loading}}">
        <icon type="waiting" size="12" color="#4DB6AC" wx:if="{{loading}}"></icon>
        点击同步云端数据
    </button>
  </view>

  <!-- 溯源完整性评估 -->
  <view class="card glass-card">
    <view class="section-title">溯源环节完整性分布</view>
    <view class="integrity-grid">
      <view class="int-cell {{stats.integrityStats.planting > 0 ? 'active' : ''}}">
        <view class="int-icon">🌱</view>
        <view class="int-label">种植基地</view>
        <view class="int-val">{{stats.integrityStats.planting || 0}}</view>
      </view>
      <view class="int-cell {{stats.integrityStats.processing > 0 ? 'active' : ''}}">
        <view class="int-icon">⚙️</view>
        <view class="int-label">生产加工</view>
        <view class="int-val">{{stats.integrityStats.processing || 0}}</view>
      </view>
      <view class="int-cell {{stats.integrityStats.inspection > 0 ? 'active' : ''}}">
        <view class="int-icon">🧪</view>
        <view class="int-label">质量检测</view>
        <view class="int-val">{{stats.integrityStats.inspection || 0}}</view>
      </view>
      <view class="int-cell {{stats.integrityStats.blockchain > 0 ? 'active' : ''}}">
        <view class="int-icon">⛓️</view>
        <view class="int-label">区块存证</view>
        <view class="int-val">{{stats.integrityStats.blockchain || 0}}</view>
      </view>
    </view>
  </view>

  <view class="distribution-row">
    <!-- 产地分布 -->
    <view class="card glass-card dist-card">
        <view class="section-title">主要产地分布</view>
        <view class="empty-mini" wx:if="{{!stats.originDist || stats.originDist.length === 0}}">暂无数据</view>
        <view class="dist-list" wx:else>
            <view class="dist-item" wx:for="{{stats.originDist}}" wx:key="name">
                <text class="d-name">{{item.name || '未知'}}</text>
                <view class="d-bar-bg">
                    <view class="d-bar" style="width:{{(item.value/stats.totalBatches)*100}}%"></view>
                </view>
                <text class="d-val">{{item.value}}</text>
            </view>
        </view>
    </view>

    <!-- 工艺分布 -->
    <view class="card glass-card dist-card">
        <view class="section-title">加工工艺分布</view>
        <view class="empty-mini" wx:if="{{!stats.processTypeDist || stats.processTypeDist.length === 0}}">暂无数据</view>
        <view class="dist-list" wx:else>
            <view class="dist-item" wx:for="{{stats.processTypeDist}}" wx:key="name">
                <text class="d-name">{{item.name}}</text>
                <view class="d-bar-bg cyan">
                    <view class="d-bar" style="width:{{(item.value/stats.totalProcessingRecords)*100}}%"></view>
                </view>
                <text class="d-val">{{item.value}}</text>
            </view>
        </view>
    </view>
  </view>

  <!-- 区块链交易记录 -->
  <view class="card glass-card">
    <view class="section-divider">
        <view class="section-title">实时区块存证索引</view>
        <view class="chain-status">
            <view class="dot-live"></view>全节点运行中
        </view>
    </view>
    
    <view class="blockchain-list" wx:if="{{stats.recentBlockchainRecords && stats.recentBlockchainRecords.length > 0}}">
      <view class="tx-item glass-card" wx:for="{{stats.recentBlockchainRecords}}" wx:key="txHash">
        <view class="tx-main">
          <view class="tx-batch">批次: {{item.batchNo}}</view>
          <view class="tx-hash">哈希: {{item.txShort}}</view>
        </view>
        <view class="tx-tag">存证成功</view>
      </view>
    </view>
    <view class="empty-state" wx:else>
      <view class="empty-icon">🛡️</view>
      <view>暂未监测到存证记录</view>
    </view>
  </view>
</view>
