.mine-page {
  padding-bottom: 150rpx;
}

.profile-card {
  height: 200rpx;
  background: linear-gradient(135deg, var(--tcm-accent) 0%, #4D1A1A 100%) !important;
  display: flex;
  align-items: center;
  color: white;
  margin-bottom: 40rpx;
  border: none !important;
}

.profile-info {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 30rpx;
}

.profile-avatar {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.profile-details {
  flex: 1;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.profile-role {
  font-size: 20rpx;
  opacity: 0.7;
}

.profile-arrow {
  font-size: 40rpx;
  opacity: 0.6;
}

/* Menu List */
.mine-menu {
  margin-bottom: 60rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 30rpx;
  padding: 30rpx !important;
  margin-bottom: 20rpx;
  background: var(--tcm-white);
}

.menu-icon {
  font-size: 32rpx;
}

.menu-text {
  flex: 1;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--tcm-text-main);
  margin-bottom: 4rpx;
}

.menu-subtitle {
  font-size: 20rpx;
  color: var(--tcm-text-sub);
}

.menu-action {
  font-size: 24rpx;
  opacity: 0.3;
}

/* Discovery Section */
.discovery-section {
  padding-bottom: 60rpx;
}

.section-header {
  margin-bottom: 30rpx;
}

.section-desc {
  font-size: 22rpx;
  color: var(--tcm-text-sub);
  margin-top: 8rpx;
}

.discovery-card {
  display: flex;
  padding: 24rpx !important;
  gap: 24rpx;
}

.discovery-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
}

.discovery-info {
  flex: 1;
}

.discovery-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--tcm-text-main);
  margin-bottom: 12rpx;
}

.discovery-excerpt {
  font-size: 22rpx;
  color: var(--tcm-text-sub);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.discovery-meta {
  font-size: 18rpx;
  color: var(--tcm-secondary);
}
