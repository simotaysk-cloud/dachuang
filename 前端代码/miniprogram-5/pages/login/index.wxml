<view class="page-container login-bg">
    <!-- 装饰性背景层 -->
    <view class="ink-blob"></view>
    
    <view class="header login-header">
        <image class="logo-icon" src="/assets/tcm_herb.png" mode="aspectFit"></image>
        <view class="title">智汇本草</view>
        <view class="desc">中药材溯源管理平台</view>
    </view>

    <view class="card glass-card">
        <view class="section-title">身份验证</view>
        
        <view class="input-group">
            <view class="field-label">管理员账号</view>
            <input class="input" placeholder="请输入账号" data-field="username" bindinput="onInput" value="{{username}}" />
        </view>

        <view class="input-group">
            <view class="field-label">登录密码</view>
            <input class="input" placeholder="请输入密码" password data-field="password" bindinput="onInput" value="{{password}}" />
        </view>

        <view class="picker-row" style="margin-bottom: 40rpx;">
            <view class="picker-label">记住登录信息</view>
            <switch color="#2E7D32" checked="{{rememberLogin}}" bindchange="onRememberLoginChange" />
        </view>

        <button class="btn btn-primary btn-hero" bindtap="handleLogin">立即登录</button>
        <view class="meta login-agreement">登录即代表您同意《智汇本草用户协议》</view>
    </view>

    <view class="card glass-card config-card">
        <view class="section-title">控制台配置</view>
        <view class="field-label">后端服务器地址</view>
        <input
            class="input"
            placeholder="例如：http://146.56.231.239:8091"
            value="{{baseUrl}}"
            bindinput="onBaseUrlInput"
        />
        <button class="btn-mini-outline" bindtap="saveBaseUrlAndCheck" style="margin-top: 10rpx; width: 100%;">同步并测试连接</button>
    </view>

    <view class="login-footer">版本 1.0.2</view>
</view>
