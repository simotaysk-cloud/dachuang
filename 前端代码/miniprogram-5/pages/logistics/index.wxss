.logistics-page {
  padding-bottom: 40rpx;
}

/* 发运英雄区 */
.logi-hero-section {
  padding: 40rpx;
  background: linear-gradient(135deg, rgba(77, 182, 172, 0.05), rgba(33, 150, 243, 0.05));
}

.logi-scan-area {
  background: #2196F3;
  padding: 40rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 30rpx;
  color: #fff;
  box-shadow: 0 16rpx 32rpx rgba(33, 150, 243, 0.2);
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

.logi-visual {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.logi-truck {
  font-size: 60rpx;
  z-index: 2;
  animation: truckShake 1s infinite ease-in-out;
}

@keyframes truckShake {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4rpx); }
}

.road-lines {
  position: absolute;
  bottom: 20%;
  width: 60%;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.3);
}

.logi-info .main-label {
  font-size: 38rpx;
  font-weight: 800;
}

.logi-info .sub-label {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 6rpx;
}

/* 运单卡片 */
.ship-card {
  margin-bottom: 24rpx;
  padding: 30rpx;
}

.ship-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid var(--border-color);
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

.ship-no {
  font-size: 24rpx;
  color: var(--text-light);
  font-family: monospace;
}

.status-badge {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.status-badge.transit {
  background: rgba(33, 150, 243, 0.1);
  color: #2196F3;
}

.status-badge.delivered {
  background: rgba(46, 125, 50, 0.1);
  color: #2E7D32;
}

.ship-body {
  display: grid;
  gap: 12rpx;
}

.ship-row {
  display: flex;
  font-size: 26rpx;
}

.s-label {
  color: var(--text-sub);
  width: 140rpx;
}

.s-value {
  color: var(--text-main);
  font-weight: 500;
}

.ship-footer {
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.carrier-text {
  font-size: 22rpx;
  color: var(--text-light);
}

.detail-link {
  font-size: 22rpx;
  color: #2196F3;
  font-weight: 600;
}

/* 轨迹时间线 */
.timeline-container {
  padding: 40rpx 10rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: var(--radius-md);
  margin-bottom: 40rpx;
}

.timeline-item {
  display: flex;
  gap: 30rpx;
  min-height: 120rpx;
}

.timeline-dots {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  background: var(--border-strong);
  border-radius: 50%;
  position: relative;
}

.dot.active {
  background: #2196F3;
  box-shadow: 0 0 15rpx #2196F3;
  width: 24rpx;
  height: 24rpx;
}

.line {
  flex: 1;
  width: 2rpx;
  background: var(--border-color);
}

.timeline-content {
  flex: 1;
  padding-bottom: 40rpx;
}

.time-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.t-status {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.t-time {
  font-size: 20rpx;
  color: var(--text-light);
}

.t-location {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

.t-details {
  font-size: 22rpx;
  color: var(--text-light);
  background: rgba(0,0,0,0.03);
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
}

/* 表单区 */
.add-event-form {
  border-top: 2rpx dashed var(--border-color);
  padding-top: 30rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: var(--text-main);
}

.action-grid-event {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 30rpx;
}

.empty-logi {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.3;
}