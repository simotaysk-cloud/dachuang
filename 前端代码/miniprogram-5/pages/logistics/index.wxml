<view class="page-container logistics-page">
    <view class="ink-blob-bottom"></view>
    
    <view class="header">
        <view class="title">物流追踪</view>
        <view class="desc">实时监测药材在途动态与数字化签收</view>
    </view>

    <!-- 发运管理 -->
    <view class="card glass-card logi-hero-section">
        <view class="section-title">发运指令</view>
        <view class="logi-scan-area" bindtap="onScanStart">
            <view class="logi-visual">
                <view class="logi-truck">🚚</view>
                <view class="road-lines"></view>
            </view>
            <view class="logi-info">
                <view class="main-label">扫码发运</view>
                <view class="sub-label">扫描待发批次 直接创建发运电子运单</view>
            </view>
        </view>
        
        <view class="btn-grid-secondary">
            <button class="btn btn-outline" bindtap="startCreateShipment">手工创建</button>
            <button class="btn btn-outline" bindtap="listShipments">同步任务</button>
        </view>
    </view>

    <!-- 运单列表 -->
    <view class="card glass-card">
        <view class="section-divider">
            <view class="section-title">电子运单台账</view>
            <view class="count-badge" wx:if="{{shipments.length}}">共 {{shipments.length}} 单</view>
        </view>

        <view class="search-section">
            <view class="search-bar">
                <input class="input-inline" placeholder="输入批次号查运单" value="{{shipmentQueryBatchNo}}" bindinput="onShipmentQueryInput" />
                <button class="btn-small search-btn" bindtap="listShipments">检索</button>
            </view>
        </view>

        <!-- 列表内容 -->
        <view class="shipment-list" wx:if="{{shipments && shipments.length > 0}}">
            <view class="ship-card glass-card" wx:for="{{shipments}}" wx:key="id" bindtap="viewShipmentDetail" data-item="{{item}}">
                <view class="ship-header">
                    <text class="ship-no">单号: {{item.shipmentNo}}</text>
                    <text class="status-badge {{item.status === 'DELIVERED' ? 'delivered' : 'transit'}}">{{item.status || '在途'}}</text>
                </view>
                <view class="ship-body">
                    <view class="ship-row">
                        <text class="s-label">承载批次:</text>
                        <text class="s-value">{{item.batchNo}}</text>
                    </view>
                    <view class="ship-row">
                        <text class="s-label">收货组织:</text>
                        <text class="s-value">{{item.distributorName || '待指定'}}</text>
                    </view>
                </view>
                <view class="ship-footer">
                    <text class="carrier-text">承运商: {{item.carrier || '自有物流'}}</text>
                    <text class="detail-link">轨迹详情 &gt;</text>
                </view>
            </view>
        </view>
        
        <view class="empty-state" wx:if="{{(!shipments || shipments.length === 0) && !loading}}">
            <view class="empty-logi">📦</view>
            <view>暂无相关的物流单据记录</view>
        </view>
    </view>

    <!-- 轨迹追踪详情 (选中运单后弹出) -->
    <view class="modal-mask" wx:if="{{currentShipment}}">
        <view class="modal glass-card modal-scroll">
            <view class="modal-title">物流轨迹: {{currentShipment.shipmentNo}}</view>
            
            <view class="timeline-container">
                <view class="timeline-item" wx:for="{{events}}" wx:key="id">
                    <view class="timeline-dots">
                        <view class="dot {{index === 0 ? 'active' : ''}}"></view>
                        <view class="line" wx:if="{{index < events.length - 1}}"></view>
                    </view>
                    <view class="timeline-content">
                        <view class="time-header">
                            <text class="t-status">{{item.status}}</text>
                            <text class="t-time">{{item.eventTime}}</text>
                        </view>
                        <view class="t-location">📍 {{item.location}}</view>
                        <view class="t-details" wx:if="{{item.details}}">{{item.details}}</view>
                    </view>
                </view>
                <view class="empty-timeline" wx:if="{{!events || events.length === 0}}">
                    该运单暂无详细位置回传记录
                </view>
            </view>

            <view class="add-event-form">
                <view class="form-title">更新实时位置</view>
                <input class="input" placeholder="输入当前所在位置" value="{{shipmentEventForm.location}}" data-field="location" bindinput="onShipmentEventInput" />
                <input class="input" placeholder="定义当前状态 (如：到达枢纽、配送中)" value="{{shipmentEventForm.status}}" data-field="status" bindinput="onShipmentEventInput" />
                <textarea class="textarea" placeholder="详细备注说明" value="{{shipmentEventForm.details}}" data-field="details" bindinput="onShipmentEventInput" />
                
                <view class="action-grid-event">
                    <button class="btn btn-outline" bindtap="closeShipmentDetail">关闭</button>
                    <button class="btn btn-primary" bindtap="addShipmentEvent">提交更新</button>
                </view>
            </view>
        </view>
    </view>
</view>
