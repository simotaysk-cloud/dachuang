page {
  background-color: #fcf9f3;
  color: #1c1c18;
  font-family: 'SF Pro Display', 'PingFang SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  box-sizing: border-box;
}

.glass-panel {
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(23, 54, 40, 0.08);
  border-radius: 24rpx;
}

.ui-icon {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.ui-icon > view {
  box-sizing: border-box;
}

.ui-leaf__left,
.ui-leaf__right,
.ui-search__ring,
.ui-store__body,
.ui-store__roof,
.ui-shield__shell,
.ui-doc__page,
.ui-lock__body,
.ui-bubble__back,
.ui-bubble__front,
.ui-bin__body,
.ui-user__head,
.ui-user__shoulder,
.ui-link__left,
.ui-link__right {
  border-color: currentColor;
}

.ui-leaf__left,
.ui-leaf__right,
.ui-search__handle,
.ui-store__door,
.ui-spark__core,
.ui-spark__ray-a,
.ui-spark__ray-b,
.ui-shield__dot,
.ui-check__short,
.ui-check__long,
.ui-doc__line,
.ui-lock__shackle,
.ui-chevron__a,
.ui-chevron__b,
.ui-send__stem,
.ui-send__head-a,
.ui-send__head-b,
.ui-user__neck,
.ui-bin__lid,
.ui-bin__line,
.ui-link__bridge,
.ui-brand__ring,
.ui-bell__clapper {
  background: currentColor;
}

.ui-leaf__left,
.ui-leaf__right {
  position: absolute;
  top: 12%;
  width: 34%;
  height: 52%;
  border-width: 4rpx;
  border-style: solid;
  border-radius: 70% 70% 50% 50%;
  background: transparent;
}

.ui-leaf__left {
  left: 18%;
  transform: rotate(-34deg);
}

.ui-leaf__right {
  right: 18%;
  transform: rotate(34deg);
}

.ui-leaf__stem {
  position: absolute;
  bottom: 10%;
  left: 50%;
  width: 4rpx;
  height: 40%;
  border-radius: 999rpx;
  background: currentColor;
  transform: translateX(-50%);
}

.ui-search__ring {
  width: 62%;
  height: 62%;
  border-width: 4rpx;
  border-style: solid;
  border-radius: 999rpx;
  background: transparent;
}

.ui-search__handle {
  position: absolute;
  right: 12%;
  bottom: 18%;
  width: 28%;
  height: 4rpx;
  border-radius: 999rpx;
  transform: rotate(45deg);
}

.ui-store__roof {
  position: absolute;
  top: 14%;
  left: 16%;
  width: 68%;
  height: 18%;
  border-width: 4rpx;
  border-style: solid;
  border-bottom: 0;
  border-radius: 10rpx 10rpx 0 0;
  background: transparent;
}

.ui-store__body {
  position: absolute;
  bottom: 14%;
  left: 20%;
  width: 60%;
  height: 40%;
  border-width: 4rpx;
  border-style: solid;
  border-radius: 8rpx;
  background: transparent;
}

.ui-store__door {
  position: absolute;
  left: 44%;
  bottom: 14%;
  width: 12%;
  height: 20%;
  border-radius: 8rpx 8rpx 0 0;
}

.ui-spark__core {
  width: 34%;
  height: 34%;
  border-radius: 8rpx;
  transform: rotate(45deg);
}

.ui-spark__ray-a,
.ui-spark__ray-b {
  position: absolute;
  width: 72%;
  height: 4rpx;
  border-radius: 999rpx;
}

.ui-spark__ray-b {
  transform: rotate(90deg);
}

.ui-shield__shell {
  position: absolute;
  inset: 14%;
  border-width: 4rpx;
  border-style: solid;
  border-radius: 14rpx 14rpx 18rpx 18rpx;
  background: transparent;
  transform: rotate(45deg);
}

.ui-shield__dot {
  width: 18%;
  height: 18%;
  border-radius: 999rpx;
  opacity: 0.95;
}

.ui-check__short,
.ui-check__long {
  position: absolute;
  height: 4rpx;
  border-radius: 999rpx;
  transform-origin: center;
}

.ui-check__short {
  width: 24%;
  left: 24%;
  top: 56%;
  transform: rotate(42deg);
}

.ui-check__long {
  width: 44%;
  left: 36%;
  top: 50%;
  transform: rotate(-46deg);
}

.ui-doc__page {
  position: absolute;
  inset: 12%;
  border-width: 4rpx;
  border-style: solid;
  border-radius: 12rpx;
  background: transparent;
}

.ui-doc__line {
  position: absolute;
  left: 26%;
  width: 46%;
  height: 4rpx;
  border-radius: 999rpx;
  opacity: 0.95;
}

.ui-doc__line--1 {
  top: 34%;
}

.ui-doc__line--2 {
  top: 48%;
}

.ui-doc__line--3 {
  top: 62%;
  width: 34%;
}

.ui-lock__body {
  position: absolute;
  left: 24%;
  bottom: 14%;
  width: 52%;
  height: 40%;
  border-width: 4rpx;
  border-style: solid;
  border-radius: 12rpx;
  background: transparent;
}

.ui-lock__shackle {
  position: absolute;
  left: 33%;
  top: 16%;
  width: 34%;
  height: 28%;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 999rpx 999rpx 0 0;
  background: transparent;
}

.ui-bell__body {
  position: absolute;
  left: 26%;
  top: 22%;
  width: 48%;
  height: 42%;
  border: 4rpx solid currentColor;
  border-bottom-left-radius: 16rpx;
  border-bottom-right-radius: 16rpx;
  border-top-left-radius: 999rpx;
  border-top-right-radius: 999rpx;
  background: transparent;
}

.ui-bell__clapper {
  position: absolute;
  left: 44%;
  bottom: 18%;
  width: 12%;
  height: 12%;
  border-radius: 999rpx;
}

.ui-bubble__back,
.ui-bubble__front {
  position: absolute;
  border-width: 4rpx;
  border-style: solid;
  background: transparent;
}

.ui-bubble__back {
  left: 12%;
  top: 20%;
  width: 42%;
  height: 28%;
  border-radius: 12rpx;
  opacity: 0.72;
}

.ui-bubble__front {
  right: 14%;
  bottom: 18%;
  width: 50%;
  height: 34%;
  border-radius: 14rpx;
}

.ui-user__head {
  position: absolute;
  top: 16%;
  left: 32%;
  width: 36%;
  height: 36%;
  border-width: 4rpx;
  border-style: solid;
  border-radius: 999rpx;
  background: transparent;
}

.ui-user__shoulder {
  position: absolute;
  left: 22%;
  bottom: 16%;
  width: 56%;
  height: 24%;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 999rpx 999rpx 0 0;
  background: transparent;
}

.ui-user__neck {
  position: absolute;
  left: 48%;
  top: 48%;
  width: 4rpx;
  height: 10%;
  border-radius: 999rpx;
  transform: translateX(-50%);
}

.ui-bin__body {
  position: absolute;
  left: 28%;
  bottom: 14%;
  width: 44%;
  height: 42%;
  border: 4rpx solid currentColor;
  border-radius: 8rpx 8rpx 10rpx 10rpx;
  background: transparent;
}

.ui-bin__lid {
  position: absolute;
  left: 24%;
  top: 22%;
  width: 52%;
  height: 4rpx;
  border-radius: 999rpx;
}

.ui-bin__line {
  position: absolute;
  top: 42%;
  width: 4rpx;
  height: 20%;
  border-radius: 999rpx;
}

.ui-bin__line--1 {
  left: 40%;
}

.ui-bin__line--2 {
  left: 48%;
}

.ui-bin__line--3 {
  left: 56%;
}

.ui-link__left,
.ui-link__right {
  position: absolute;
  width: 34%;
  height: 22%;
  border: 4rpx solid currentColor;
  border-radius: 999rpx;
  background: transparent;
}

.ui-link__left {
  left: 16%;
  top: 40%;
  transform: rotate(-32deg);
}

.ui-link__right {
  right: 16%;
  top: 40%;
  transform: rotate(32deg);
}

.ui-link__bridge {
  position: absolute;
  left: 38%;
  top: 48%;
  width: 24%;
  height: 4rpx;
  border-radius: 999rpx;
}

.ui-chevron__a,
.ui-chevron__b {
  position: absolute;
  right: 20%;
  width: 44%;
  height: 4rpx;
  border-radius: 999rpx;
}

.ui-chevron__a {
  top: 38%;
  transform: rotate(45deg);
}

.ui-chevron__b {
  top: 58%;
  transform: rotate(-45deg);
}

.ui-send__stem,
.ui-send__head-a,
.ui-send__head-b {
  position: absolute;
  border-radius: 999rpx;
}

.ui-send__stem {
  left: 18%;
  top: 48%;
  width: 44%;
  height: 4rpx;
}

.ui-send__head-a,
.ui-send__head-b {
  right: 18%;
  width: 30%;
  height: 4rpx;
}

.ui-send__head-a {
  top: 38%;
  transform: rotate(36deg);
}

.ui-send__head-b {
  top: 58%;
  transform: rotate(-36deg);
}

.ui-brand__ring {
  position: absolute;
  inset: 10%;
  border: 2rpx solid rgba(23, 54, 40, 0.14);
  border-radius: 999rpx;
  background: transparent;
}

