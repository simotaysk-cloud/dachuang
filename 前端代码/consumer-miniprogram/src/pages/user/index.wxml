<view class="page">
  <view class="topbar">
    <view class="topbar-main">
      <text class="topbar-title">我的</text>
      <text class="topbar-caption">账户权益、可信凭证与常用服务</text>
    </view>
  </view>

  <view class="hero-card">
    <view class="hero-head">
      <view class="profile-block">
        <image
          wx:if="{{hasUserInfo}}"
          class="avatar"
          src="{{userInfo.avatarUrl}}"
          mode="aspectFill"
        ></image>
        <view wx:else class="avatar avatar-placeholder">
          <text class="avatar-placeholder-text">药</text>
        </view>

        <view class="profile-copy">
          <text class="profile-label">{{profileLabel}}</text>
          <text class="profile-name">{{profileName}}</text>
          <text class="profile-level">{{profileLevel}}</text>
        </view>
      </view>

      <button
        wx:if="{{!hasUserInfo}}"
        class="hero-action"
        size="mini"
        bindtap="getUserProfile"
      >安全登录</button>
      <view wx:else class="hero-state">
        <view class="hero-state-dot"></view>
        <text>同步中</text>
      </view>
    </view>

    <view class="stats-grid">
      <view wx:for="{{displayStats}}" wx:key="label" class="stat-card">
        <text class="stat-label">{{item.label}}</text>
        <text class="stat-value">{{item.value}}</text>
        <text class="stat-note">{{item.note}}</text>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head section-head-inline">
      <view>
        <text class="section-title">可信存证</text>
        <text class="section-desc">查看数字证书、权益记录和提醒状态。</text>
      </view>
      <text class="section-side">{{syncStateText}}</text>
    </view>

    <scroll-view wx:if="{{hasUserInfo}}" scroll-x class="cert-scroll">
      <view
        wx:for="{{certs}}"
        wx:key="id"
        class="cert-card"
        data-cert="{{item}}"
        bindtap="showCert"
      >
        <text class="cert-badge">至信链凭证</text>
        <text class="cert-title">{{item.name}}</text>
        <text class="cert-date">上链时间 {{item.date}}</text>
        <text class="cert-hash">存证哈希 {{item.hash}}</text>
        <view class="cert-footer">
          <text class="cert-footer-text">查看凭证</text>
          <text class="cert-footer-arrow">›</text>
        </view>
      </view>
    </scroll-view>

    <view wx:else class="empty-card">
      <text class="empty-title">当前尚未展示个人凭证</text>
      <text class="empty-desc">先完成演示登录，再查看数字证书、权益记录和提醒状态。</text>
      <button class="empty-action" size="mini" bindtap="getUserProfile">立即登录</button>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">常用服务</text>
      <text class="section-desc">溯源码、提醒与智问入口集中在这里。</text>
    </view>

    <view class="menu-list">
      <view
        wx:for="{{serviceMenus}}"
        wx:key="action"
        class="menu-item"
        data-action="{{item.action}}"
        bindtap="handleMenuAction"
      >
        <view class="menu-icon {{item.tone}}">{{item.icon}}</view>
        <view class="menu-copy">
          <text class="menu-title">{{item.title}}</text>
          <text class="menu-desc">{{item.desc}}</text>
        </view>
        <text class="menu-extra">{{item.metaDisplay}}</text>
      </view>
    </view>
  </view>
</view>
