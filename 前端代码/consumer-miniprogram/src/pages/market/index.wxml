<view class="bg-background text-on-surface min-h-screen pb-32 overflow-x-hidden">

  <view class="fixed top-0 w-full z-50 bg-[#fcf9f3]/80 backdrop-blur-xl">
    <view class="flex items-center px-6 py-4 w-full box-border">
      <view class="flex items-center gap-4 min-w-0">
        <view class="ui-icon w-6 h-6 text-[#173628] active:scale-95 duration-200">
          <view class="ui-store__roof"></view>
          <view class="ui-store__body"></view>
          <view class="ui-store__door"></view>
        </view>
        <text class="text-xl font-extrabold text-[#173628] font-['Manrope'] tracking-tight">云市集</text>
      </view>
    </view>
  </view>

  <view class="pt-16 px-6 box-border">

    <view class="mt-1">
      <view class="flex items-center gap-3 bg-surface-container rounded-xl px-4 py-3">
        <view class="flex items-center pointer-events-none flex-shrink-0">
          <view class="ui-icon w-4 h-4 text-outline">
            <view class="ui-search__ring"></view>
            <view class="ui-search__handle"></view>
          </view>
        </view>
        <input
          class="flex-1 min-w-0 bg-transparent border-none text-on-surface text-sm"
          placeholder="寻找地道药材..."
          type="text"
        />
        <view class="pl-3 border-l border-outline/15 flex-shrink-0" bindtap="handleSearch">
          <text class="text-primary text-sm font-bold tracking-wide">搜索</text>
        </view>
      </view>


      <view class="flex gap-3 mt-4 overflow-x-auto pb-2" style="white-space: nowrap;">
        <view class="px-6 py-2 rounded-full text-sm font-semibold whitespace-nowrap transition-all {{currentTab === 0 ? 'bg-primary text-on-primary' : 'bg-surface-container-low text-on-surface-variant'}}" bindtap="switchTab" data-index="{{0}}">直供饮片</view>
        <view class="px-6 py-2 rounded-full text-sm font-semibold whitespace-nowrap transition-all {{currentTab === 1 ? 'bg-primary text-on-primary' : 'bg-surface-container-low text-on-surface-variant'}}" bindtap="switchTab" data-index="{{1}}">云认养</view>
      </view>
    </view>


    <view wx:if="{{currentTab === 0}}">
      <view class="mt-3 flex justify-between items-end mb-4">
        <text class="text-2xl font-extrabold text-primary">甄选直供</text>
      </view>
      <view class="grid grid-cols-2 gap-4">
        <view class="bg-surface-container-low rounded-lg p-3 group min-w-0" wx:for="{{products}}" wx:key="id">
          <view class="aspect-square w-full rounded-md overflow-hidden bg-white mb-3">
            <image class="w-full h-full object-cover" src="{{item.image}}" mode="aspectFill"></image>
          </view>
          <view class="text-sm font-bold text-on-surface font-headline line-clamp-1">{{item.name}}</view>
          <view class="flex gap-1 mt-1 flex-wrap">
            <text class="text-[9px] px-1.5 py-0.5 bg-primary-fixed text-on-primary-fixed-variant rounded font-semibold">{{item.origin}}</text>
            <text class="text-[9px] px-1.5 py-0.5 bg-surface-container-highest text-on-surface-variant rounded font-semibold">{{item.tag}}</text>
          </view>
          <view class="mt-3 flex justify-between items-end gap-3">
            <view class="flex flex-col min-w-0 flex-1">
              <text class="text-base font-bold text-tertiary">¥{{item.price}}</text>
              <text class="text-[10px] text-outline font-medium">已售 {{item.sales}}</text>
            </view>
            <view class="w-8 h-8 rounded-full bg-white flex items-center justify-center text-primary shadow-sm hover:bg-primary hover:text-white transition-colors flex-shrink-0" bindtap="handlePurchase" data-name="{{item.name}}">
              <text class="text-lg">+</text>
            </view>
          </view>
        </view>
      </view>
    </view>


    <view wx:if="{{currentTab === 1}}">
      <view class="mt-3 flex justify-between items-end mb-4">
        <text class="text-2xl font-extrabold text-primary">数字认养</text>
      </view>
      <view class="flex flex-col gap-4">
        <view class="bg-surface-container-lowest rounded-lg overflow-hidden shadow-sm relative group transition-all duration-300 border border-outline-variant/30" wx:for="{{adoptions}}" wx:key="id">
          <view class="h-32 w-full relative">
            <image class="w-full h-full object-cover" src="{{item.image}}" mode="aspectFill"></image>
            <view class="absolute top-4 left-4 bg-primary/90 text-on-primary text-[10px] font-bold tracking-widest px-3 py-1 rounded-full uppercase">{{item.status}}</view>
          </view>
          <view class="p-5">
            <view class="text-lg font-bold text-on-surface font-headline leading-tight break-words">{{item.name}}</view>
            <view class="text-sm text-on-surface-variant mt-1 leading-relaxed">{{item.desc}}</view>
            <view class="flex gap-4 mt-3 mb-3">
               <view class="flex flex-col flex-1 min-w-0">
                 <text class="text-[10px] text-outline">认养面积</text>
                 <text class="text-xs font-bold text-on-surface">{{item.area}}</text>
               </view>
               <view class="flex flex-col flex-1 min-w-0">
                 <text class="text-[10px] text-outline">预计产出</text>
                 <text class="text-xs font-bold text-on-surface break-words">{{item.yield}}</text>
               </view>
            </view>
            <view class="flex justify-between items-end gap-4 mt-4 pt-3 border-t border-outline/10">
              <text class="text-xl font-bold text-tertiary flex-1 min-w-0">¥{{item.price}}</text>
              <view class="bg-primary text-on-primary px-4 py-2 rounded-full font-bold text-sm whitespace-nowrap flex-shrink-0" bindtap="handleAdopt" data-name="{{item.name}}">发起认养</view>
            </view>
          </view>
        </view>
      </view>
    </view>

  </view>
</view>
