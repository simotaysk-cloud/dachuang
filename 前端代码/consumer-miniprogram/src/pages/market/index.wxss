.page {
  min-height: 100vh;
  padding: 30rpx 30rpx 48rpx;
  background:
    radial-gradient(circle at top right, rgba(201, 219, 189, 0.18), transparent 30%),
    linear-gradient(180deg, #fbfaf6 0%, #f5f2ea 100%);
  box-sizing: border-box;
  color: #1f241f;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  margin-bottom: 24rpx;
}

.topbar-main {
  min-width: 0;
}

.topbar-title {
  display: block;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #203329;
}

.topbar-caption {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #68726b;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.topbar-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #506055;
  font-size: 22rpx;
}

.hero-card,
.section-card {
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 16rpx 40rpx rgba(40, 49, 43, 0.06);
}

.hero-card {
  padding: 30rpx;
  background: transparent;
  box-shadow: none;
  border-radius: 0;
}

.hero-kicker {
  display: inline-block;
  color: #6c786f;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 14rpx;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #203329;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6a746c;
}

.hero-meta {
  display: flex;
  margin-top: 20rpx;
}

.hero-chip {
  flex: 1;
  padding: 0 18rpx;
  background: transparent;
  border-left: 1rpx solid rgba(111, 122, 114, 0.14);
}

.hero-chip:first-child {
  padding-left: 0;
  border-left: none;
}

.hero-chip-value {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #254131;
}

.hero-chip-label {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #788178;
}

.tabs {
  display: flex;
  gap: 16rpx;
  margin: 22rpx 0 28rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid rgba(111, 122, 114, 0.14);
}

.tab {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 58rpx;
  border-radius: 0;
  background: transparent;
  color: #7a847c;
  font-size: 24rpx;
  position: relative;
}

.tab-active {
  color: #22412d;
  font-weight: 600;
}

.tab-active::after {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: -11rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #22412d;
}

.section-card {
  padding: 0;
  background: transparent;
  box-shadow: none;
}

.section-head {
  margin-bottom: 22rpx;
}

.section-head-inline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #223128;
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b766e;
  line-height: 1.5;
}

.section-side {
  flex-shrink: 0;
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #8a948d;
}

.product-list,
.adopt-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.product-card,
.adopt-card {
  border-radius: 0;
  background: transparent;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(111, 122, 114, 0.14);
}

.product-card:first-child,
.adopt-card:first-child {
  padding-top: 8rpx;
}

.product-card:last-child,
.adopt-card:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.product-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.product-thumb {
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.product-thumb.gold {
  background: #f3eadc;
  color: #876040;
}

.product-thumb.wood {
  background: #e7efe5;
  color: #44604d;
}

.product-main {
  flex: 1;
}

.product-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.product-name {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #213128;
}

.product-price {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #7a4d2d;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 10rpx;
}

.product-tag {
  padding: 0;
  background: transparent;
  color: #728077;
  font-size: 20rpx;
  border: none;
}

.product-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #667068;
  line-height: 1.6;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}

.product-meta {
  font-size: 20rpx;
  color: #818b83;
}

.action-button {
  margin: 0 !important;
  padding: 0 22rpx !important;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #274833;
  border: 1rpx solid rgba(39, 72, 51, 0.28);
  font-size: 22rpx;
}

.action-button-wide {
  width: 100%;
  margin-top: 20rpx !important;
}

.adopt-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.adopt-name {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #223128;
}

.adopt-status {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #5e6d63;
  border: 1rpx solid rgba(111, 122, 114, 0.18);
  font-size: 20rpx;
}

.adopt-grid {
  display: flex;
  gap: 22rpx;
  margin-top: 16rpx;
}

.adopt-meta {
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.adopt-label {
  display: block;
  font-size: 20rpx;
  color: #7c857d;
}

.adopt-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #233129;
}

.adopt-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #667169;
}
