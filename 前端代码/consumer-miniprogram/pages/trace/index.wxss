page {
  background-color: #f5f7fa;
  background-image: radial-gradient(#d1d5db 2rpx, transparent 2rpx);
  background-size: 48rpx 48rpx;
  color: #1e293b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container {
  padding: 32rpx 32rpx 100rpx;
  position: relative;
}

/* Decryption Anim */
.bc-decryption {
  position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(16rpx);
  z-index: 999;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.bc-dec-text { font-family: monospace; color: #2563eb; font-size: 32rpx; margin-bottom: 48rpx; font-weight: bold; }
.bc-progress { width: 70%; height: 12rpx; background: #e2e8f0; border-radius: 6rpx; overflow: hidden; }
.bc-bar { height: 100%; background: #2563eb; transition: width 0.1s; }

/* Error State */
.error-state {
  height: 80vh; display: flex; flex-direction: column; justify-content: center; align-items: center;
}
.error-icon-wrapper { width: 120rpx; height: 120rpx; background: rgba(239, 68, 68, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 30rpx; }
.error-icon { font-size: 60rpx; }
.error-title { font-size: 40rpx; font-weight: bold; color: #f87171; margin-bottom: 16rpx; }
.error-text { font-size: 28rpx; color: #64748b; margin-bottom: 60rpx; }
.back-btn { background: #1e293b; color: #fff; border-radius: 100rpx; font-size: 28rpx; width: 300rpx !important; }

/* Cards */
.card { background: #ffffff; border: 2rpx solid #e2e8f0; border-radius: 32rpx; padding: 40rpx; box-shadow: 0 20rpx 50rpx -10rpx rgba(0,0,0,0.05); margin-bottom: 40rpx; }
.section-title { font-size: 34rpx; font-weight: 700; color: #0f172a; margin-bottom: 32rpx; display: flex; align-items: center; }
.section-title::before { content: ''; width: 8rpx; height: 32rpx; background: #2563eb; border-radius: 4rpx; margin-right: 16rpx; }

/* Hero */
.hero-section { display: flex; flex-direction: column; align-items: center; padding: 20rpx 0 40rpx; animation: fadeIn 0.8s ease forwards; }
.product-hero { position: relative; display: flex; flex-direction: column; align-items: center; margin-bottom: 48rpx; }
.herb-circle { width: 240rpx; height: 240rpx; border-radius: 50%; background: #eff6ff; border: 4rpx solid #fff; box-shadow: 0 20rpx 50rpx rgba(37,99,235,0.15); display: flex; align-items: center; justify-content: center; font-size: 100rpx; z-index: 2; position: relative; }

.laser-scanner { position: absolute; top: -20rpx; width: 280rpx; height: 280rpx; pointer-events: none; z-index: 10; display: flex; justify-content: center; }
.laser-beam { width: 120%; height: 4rpx; background: #2563eb; box-shadow: 0 0 20rpx 4rpx rgba(37,99,235,0.5); animation: scan 2s linear infinite; position: relative; }
@keyframes scan { 0% { transform: translateY(-20rpx); opacity:0;} 10% {opacity:1;} 90% {opacity:1;} 100% {transform: translateY(280rpx); opacity:0;} }

.auth-badge { background: #ecfdf5; border: 2rpx solid #34d399; color: #059669; padding: 12rpx 32rpx; border-radius: 48rpx; font-size: 28rpx; font-weight: bold; margin-top: 40rpx; box-shadow: 0 8rpx 24rpx rgba(16,185,129,0.15); display: flex; align-items: center; }
.auth-badge .icon { margin-right: 12rpx; font-size: 30rpx;}

/* Metrics */
.metrics-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24rpx; width: 100%; margin-top: 20rpx; }
.metric-card { background: #f8fafc; border: 2rpx solid #e2e8f0; border-radius: 24rpx; padding: 32rpx 20rpx; text-align: center; }
.metric-val { font-size: 44rpx; font-weight: 800; font-family: monospace; color: #0f172a; }
.metric-lbl { font-size: 24rpx; color: #64748b; margin-top: 8rpx; font-weight: 500; }

/* TCM Section */
.tcm-header { border-left-color: #8b5cf6; }
.tcm-header::before { background: #8b5cf6; }
.tcm-hero-row { display: flex; align-items: center; margin-bottom: 40rpx; padding-bottom: 40rpx; border-bottom: 2rpx solid #e2e8f0; }
.tcm-char { font-size: 96rpx; font-weight: 900; color: #8b5cf6; margin-right: 40rpx; }
.tcm-tags { display: flex; flex-direction: column; gap: 16rpx; }
.tcm-tag { background: #f3e8ff; border: 2rpx solid #e9d5ff; color: #7e22ce; font-size: 24rpx; font-weight: 600; padding: 8rpx 20rpx; border-radius: 12rpx; text-align: center;}

.tcm-meta { flex: 1; margin-left: 24rpx; font-size: 28rpx; line-height: 1.8; }
.tcm-meta-row { display: flex; justify-content: space-between; align-items: center; }
.tcm-meta-lbl { color: #64748b; font-size: 26rpx; }
.tcm-meta-val { color: #1e293b; font-weight: 500;}
.tcm-meta-hl { color: #8b5cf6; font-weight: 700; }

.twin-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx; }
.twin-box { background: #f8fafc; border-radius: 24rpx; padding: 24rpx; border: 2rpx solid #e2e8f0; }
.twin-title { font-size: 26rpx; font-weight: 700; color: #64748b; margin-bottom: 24rpx; border-bottom: 2rpx dashed #e2e8f0; padding-bottom: 12rpx; }
.peiwu-item { font-size: 26rpx; color: #1e293b; margin-bottom: 16rpx; display: flex; align-items: center; line-height: 1.5; }
.peiwu-item::before { content: ''; width: 12rpx; height: 12rpx; background: #8b5cf6; border-radius: 50%; margin-right: 16rpx; flex-shrink: 0; }
.env-inner-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.env-val { font-size: 30rpx; color: #8b5cf6; font-family: monospace; font-weight: 700; }
.env-lbl { font-size: 22rpx; color: #64748b; margin-top: 4rpx; }

/* Timeline */
.timeline { padding-left: 40rpx; margin-left: 20rpx; border-left: 4rpx solid #cbd5e1; position: relative; margin-top: 20rpx;}
.tl-item { position: relative; margin-bottom: 48rpx; }
.tl-item:last-child { margin-bottom: 0; }
.tl-dot { position: absolute; width: 28rpx; height: 28rpx; background: #fff; border: 6rpx solid #2563eb; border-radius: 50%; left: -58rpx; top: 8rpx; box-shadow: 0 0 0 8rpx #eff6ff; }
.tl-card { position: relative; background: #f8fafc; border: 2rpx solid #e2e8f0; border-radius: 24rpx; padding: 32rpx; transition: 0.2s; }
.tl-card-hover { box-shadow: 0 8rpx 12rpx -2rpx rgba(0,0,0,0.05); border-color: #cbd5e1; background: #f1f5f9; }
.tl-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; margin-right: 120rpx;}
.tl-title { font-size: 30rpx; font-weight: 700; color: #1e293b; }
.tl-badge { font-size: 22rpx; padding: 4rpx 16rpx; background: #e0e7ff; color: #4338ca; border-radius: 8rpx; font-weight: 600; }
.tl-sub { display: inline-block; color: #64748b; font-size: 24rpx; margin-bottom: 20rpx; background: #f1f5f9; padding: 4rpx 16rpx; border-radius: 8rpx;}
.tl-body { font-size: 26rpx; color: #475569; line-height: 1.6; display: block;}
.tl-hint { position: absolute; right: 24rpx; top: 32rpx; color: #2563eb; font-size: 22rpx; font-weight: bold; background: #eff6ff; padding: 8rpx 16rpx; border-radius: 24rpx; }

/* Modal */
.modal-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8rpx); z-index: 9999; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
.modal-overlay.show { opacity: 1; pointer-events: auto; }
.modal-content { background: #fff; width: 85%; max-width: 800rpx; border-radius: 32rpx; padding: 40rpx; box-shadow: 0 40rpx 50rpx -10rpx rgba(0,0,0,0.1); transform: translateY(40rpx) scale(0.95); transition: all 0.3s; max-height: 80vh; display: flex; flex-direction: column; }
.modal-overlay.show .modal-content { transform: translateY(0) scale(1); }

.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32rpx; padding-bottom: 24rpx; border-bottom: 2rpx solid #e2e8f0; flex-shrink: 0;}
.modal-title { font-size: 34rpx; font-weight: 800; color: #0f172a; display: flex; align-items: center;}
.modal-icon { margin-right: 16rpx; font-size: 36rpx;}
.modal-close { background: #f1f5f9; width: 64rpx; height: 64rpx; border-radius: 50%; font-size: 40rpx; line-height: 60rpx; color: #64748b; text-align: center;}

.modal-body { flex: 1; padding-right: 8rpx; }
.modal-kv { display: flex; flex-direction: column; margin-bottom: 24rpx; background: #f8fafc; padding: 24rpx; border-radius: 16rpx; border: 2rpx solid #e2e8f0;}
.modal-kv:last-child { margin-bottom: 0; }
.modal-lbl { font-size: 24rpx; color: #64748b; margin-bottom: 8rpx; }
.modal-val { font-size: 28rpx; color: #1e293b; font-weight: 500; word-break: break-all; }
.modal-img { max-width: 100%; border-radius: 16rpx; margin-top: 16rpx; border: 2rpx solid #e2e8f0; }
.modal-link { font-size: 26rpx; color: #2563eb; font-weight: 600; text-decoration: underline; margin-top: 8rpx; }
.modal-empty { text-align: center; color: #94a3b8; padding: 40rpx; font-size: 28rpx; }