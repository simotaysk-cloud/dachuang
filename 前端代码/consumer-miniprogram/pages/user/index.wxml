<view class="container">
  
  <view class="user-header">
    <view class="user-info" bindtap="{{!hasUserInfo ? 'getUserProfile' : ''}}">
      <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view class="info-text">
        <view class="nickname">{{userInfo.nickName}}</view>
        <view class="level-tag"><text class="level-icon">🏅</text>{{userInfo.level}}</view>
      </view>
    </view>
    
    <view class="user-stats">
      <view class="stat-item">
        <view class="stat-num">{{userInfo.points}}</view>
        <view class="stat-lbl">本草积分</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{hasUserInfo ? '1' : '0'}}</view>
        <view class="stat-lbl">数字证书</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">0</view>
        <view class="stat-lbl">助农订单</view>
      </view>
    </view>
  </view>

  <view class="asset-section">
    <view class="section-title">我的数字确权证书</view>
    <scroll-view scroll-x class="cert-scroll">
      <view class="cert-card" wx:for="{{certs}}" wx:key="id" bindtap="showCert" data-cert="{{item}}" wx:if="{{hasUserInfo}}">
        <view class="cert-glow"></view>
        <view class="cert-content">
          <text class="cert-title">{{item.name}}</text>
          <text class="cert-hash">TX Hash: {{item.hash}}</text>
          <text class="cert-date">{{item.date}}</text>
          <view class="cert-badge">至信链存证</view>
        </view>
      </view>
      
      <view class="cert-empty" wx:if="{{!hasUserInfo}}">
        <text class="empty-icon">🔐</text>
        <text class="empty-text">登录后查看您的区块链助农荣誉证书</text>
        <button class="login-btn" bindtap="getUserProfile">安全授权登录</button>
      </view>
    </scroll-view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="scanCode">
      <view class="m-left"><text class="m-icon">📷</text>扫描溯源防伪码</view>
      <view class="m-right">›</view>
    </view>
    <view class="menu-item" bindtap="setupReminder">
      <view class="m-left"><text class="m-icon">⏰</text>智能用药管家提醒</view>
      <view class="m-right">{{reminderText}} ›</view>
    </view>
    <view class="menu-item" bindtap="contactService">
      <view class="m-left"><text class="m-icon">🎧</text>联系专属药师客服</view>
      <view class="m-right">›</view>
    </view>
    <view class="menu-item" bindtap="showAbout">
      <view class="m-left"><text class="m-icon">🛡️</text>关于 至信链·药途寻迹</view>
      <view class="m-right">›</view>
    </view>
  </view>

</view>
