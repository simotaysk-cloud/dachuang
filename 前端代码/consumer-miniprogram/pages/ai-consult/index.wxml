<view class="chat-container">
  <scroll-view class="chat-box" scroll-y scroll-into-view="{{scrollToId}}" scroll-with-animation>
    <!-- AI Intro Card -->
    <view class="message ai" id="msg-intro">
      <image class="avatar ai-avatar" src="https://cpuzhbc.cn/assets/tcm_herb.png" mode="aspectFill"></image>
      <view class="bubble">
        <text>您好！我是您的名医智问管家，基于百万卷国医典籍与镇坪道地本草大模型库训练。请问您今天想问诊哪方面的调理需求？（例如：近期经常熬夜、长痘口干等）</text>
      </view>
    </view>

    <!-- Dynamic Messages -->
    <block wx:for="{{messages}}" wx:key="id">
      <view class="message {{item.role}}" id="msg-{{item.id}}">
        <image class="avatar ai-avatar" wx:if="{{item.role === 'ai'}}" src="https://cpuzhbc.cn/assets/tcm_herb.png" mode="aspectFill"></image>
        <view class="bubble">
          <text>{{item.text}}</text>
          
          <!-- Recommendation Product Card (Mock for Business presentation) -->
          <view class="recommendation-card" wx:if="{{item.showProduct}}" bindtap="mockPurchase">
            <view class="rec-title">镇坪精选搭配：黄连百合定神汤 ➔</view>
            <view class="rec-buy">AI一键问药</view>
          </view>
        </view>
        <view class="avatar user-avatar" wx:if="{{item.role === 'user'}}">客</view>
      </view>
    </block>
    
    <view class="typing-indicator" wx:if="{{isTyping}}">
      <text class="dot"></text><text class="dot"></text><text class="dot"></text>
    </view>
    <view class="pad-bottom"></view>
  </scroll-view>

  <view class="input-area">
    <input class="chat-input" placeholder="请描述您的症状或用药需求..." model:value="{{inputValue}}" bindconfirm="sendMessage" confirm-type="send" cursor-spacing="20" />
    <button class="send-btn" bindtap="sendMessage">悬壶</button>
  </view>
</view>