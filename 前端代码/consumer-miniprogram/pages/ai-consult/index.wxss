.chat-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #0f172a;
}
.chat-box {
  flex: 1;
  padding: 30rpx;
  box-sizing: border-box;
}
.message {
  display: flex;
  margin-bottom: 40rpx;
  align-items: flex-start;
}
.message.user {
  justify-content: flex-end;
}
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
}
.ai-avatar {
  background: #1e293b;
  border: 2rpx solid rgba(52, 211, 153, 0.4);
}
.user-avatar {
  background: #38bdf8;
  color: #fff;
  border: 2rpx solid rgba(56, 189, 248, 0.4);
}
.bubble {
  max-width: 65%;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}
.ai .bubble {
  margin-left: 20rpx;
  background: rgba(30, 41, 59, 0.8);
  color: #f1f5f9;
  border-top-left-radius: 4rpx;
  border: 1px solid rgba(255, 255, 255, 0.05);
}
.user .bubble {
  margin-right: 20rpx;
  background: -webkit-linear-gradient(45deg, #059669, #10b981);
  color: #ffffff;
  border-top-right-radius: 4rpx;
  box-shadow: 0 10rpx 20rpx rgba(16, 185, 129, 0.2);
}

.recommendation-card {
  margin-top: 20rpx;
  padding: 20rpx;
  background: rgba(16, 185, 129, 0.1);
  border-radius: 16rpx;
  border: 1px solid rgba(52, 211, 153, 0.3);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rec-title {
  font-size: 24rpx;
  color: #34d399;
  font-weight: 600;
}
.rec-buy {
  font-size: 20rpx;
  background: #10b981;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
}

.input-area {
  padding: 20rpx 30rpx;
  padding-bottom: env(safe-area-inset-bottom, 30rpx);
  background: rgba(15, 23, 42, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
}
.chat-input {
  flex: 1;
  height: 80rpx;
  background: rgba(30, 41, 59, 1);
  border-radius: 40rpx;
  padding: 0 40rpx;
  color: #fff;
  font-size: 28rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
}
.send-btn {
  margin-left: 20rpx;
  width: 140rpx !important;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0;
  background: -webkit-linear-gradient(45deg, #10b981, #34d399);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  font-weight: 600;
}
.pad-bottom { height: 100rpx; }
.typing-indicator { margin-left: 130rpx; display:flex; gap: 8rpx; margin-bottom: 40rpx; align-items: center; height: 40rpx;}
.dot { width: 12rpx; height: 12rpx; background: #34d399; border-radius: 50%; animation: bounce 1.4s infinite ease-in-out both; }
.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
@keyframes bounce { 0%, 80%, 100% { transform: scale(0); } 40% { transform: scale(1); } }