.container {
  min-height: 100vh;
  padding: 40rpx 30rpx;
  position: relative;
  overflow: hidden;
}

.ambient-glow {
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(16, 185, 129, 0.3) 0%, rgba(15, 23, 42, 0) 70%);
  border-radius: 50%;
  z-index: 0;
  filter: blur(40px);
}

.header {
  position: relative;
  z-index: 1;
  margin-top: 80rpx;
  margin-bottom: 60rpx;
}

.welcome-text {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 28rpx;
  color: #94a3b8;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.brand {
  font-size: 64rpx;
  font-weight: 800;
  color: #f8fafc;
  background: -webkit-linear-gradient(45deg, #34d399, #10b981);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-card {
  position: relative;
  z-index: 1;
  background: rgba(30, 41, 59, 0.6);
  border: 1px solid rgba(52, 211, 153, 0.3);
  border-radius: 32rpx;
  padding: 50rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.4), inset 0 2rpx 10rpx rgba(255,255,255,0.1);
  margin-bottom: 80rpx;
  transition: all 0.3s ease;
}
.hero-card:active {
  transform: scale(0.98);
}

.hero-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-right: 30rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.5);
}

.hero-desc {
  font-size: 24rpx;
  color: #cbd5e1;
  line-height: 1.6;
}

.scan-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(16, 185, 129, 0.15);
  border: 4rpx solid #34d399;
  position: relative;
  overflow: hidden;
  box-shadow: 0 0 30rpx rgba(52, 211, 153, 0.4);
}

.laser-line {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 4rpx;
  background: #10b981;
  box-shadow: 0 0 15rpx #34d399, 0 0 30rpx #34d399;
  animation: scan 2s infinite cubic-bezier(0.4, 0, 0.6, 1);
}

@keyframes scan {
  0% { top: -10%; opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { top: 110%; opacity: 0; }
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
  z-index: 1;
  position: relative;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #f1f5f9;
}

.section-badge {
  font-size: 22rpx;
  color: #10b981;
  background: rgba(16, 185, 129, 0.15);
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  border: 1px solid rgba(16, 185, 129, 0.4);
}

.feed-list {
  z-index: 1;
  position: relative;
  padding-bottom: 60rpx;
}

.feed-card {
  display: flex;
  background: rgba(30, 41, 59, 0.5);
  border-radius: 24rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.2);
}

.feed-img {
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
  background: #334155;
}

.feed-info {
  padding: 24rpx 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.feed-tag {
  font-size: 22rpx;
  color: #38bdf8;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.feed-headline {
  font-size: 30rpx;
  font-weight: 600;
  color: #f8fafc;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.feed-excerpt {
  font-size: 24rpx;
  color: #94a3b8;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.5;
}