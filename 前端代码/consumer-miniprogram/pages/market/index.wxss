page {
  background-color: #0f172a;
  color: #fff;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}
.container { padding-bottom: 60rpx; }

/* Banner */
.header-banner {
  padding: 60rpx 40rpx;
  position: relative;
  overflow: hidden;
}
.banner-glow {
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(52, 211, 153, 0.2) 0%, rgba(15, 23, 42, 0) 70%);
  filter: blur(40px);
  z-index: -1;
}
.banner-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}
.banner-sub {
  font-size: 26rpx;
  color: #94a3b8;
}

/* Tabs */
.custom-tabs {
  display: flex;
  padding: 0 40rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  margin-bottom: 40rpx;
}
.tab-item {
  margin-right: 60rpx;
  font-size: 30rpx;
  color: #94a3b8;
  padding-bottom: 24rpx;
  position: relative;
  transition: 0.3s;
}
.tab-item.active {
  color: #34d399;
  font-weight: bold;
}
.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #34d399;
  border-radius: 6rpx;
  box-shadow: 0 0 10rpx #34d399;
}

/* List */
.list-container {
  padding: 0 40rpx;
  animation: fadeIn 0.5s ease;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* Product Card */
.product-card {
  display: flex;
  background: rgba(30, 41, 59, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  backdrop-filter: blur(20px);
}
.product-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #1e293b;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.p-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #f1f5f9;
  margin-bottom: 12rpx;
}
.p-tags { margin-bottom: 16rpx; display: flex; align-items: center; }
.p-tag {
  background: rgba(16, 185, 129, 0.1);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.3);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.p-meta {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: auto;
}
.p-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}
.p-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #f87171;
  font-family: monospace;
}
.p-unit {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: normal;
}
.buy-btn {
  margin: 0 !important;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #fff;
  font-size: 24rpx;
  border-radius: 100rpx;
  padding: 4rpx 32rpx;
  height: 56rpx;
  line-height: 56rpx;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.4);
}

/* Adopt Card */
.adopt-card {
  background: rgba(30, 41, 59, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  position: relative;
}
.adopt-status {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: rgba(15, 23, 42, 0.8);
  backdrop-filter: blur(10px);
  color: #38bdf8;
  border: 1px solid #0284c7;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  z-index: 10;
}
.adopt-img {
  width: 100%;
  height: 280rpx;
  background: #1e293b;
}
.adopt-info {
  padding: 32rpx;
}
.a-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #f1f5f9;
  margin-bottom: 12rpx;
  display: block;
}
.a-desc {
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 24rpx;
  display: block;
}
.a-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.a-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #f87171;
}
.adopt-btn {
  margin: 0 !important;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #fff;
  font-size: 26rpx;
  border-radius: 16rpx;
  padding: 0 40rpx;
  height: 64rpx;
  line-height: 64rpx;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.3);
}
